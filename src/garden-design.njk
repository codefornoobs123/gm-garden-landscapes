<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do I need a detailed design before you start?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Some customers come to us with a clear plan; others just know they want the garden to work better. Either way, we'll talk it through on site and put forward a layout and materials that suit how you want to use the space."
      }
    },
    {
      "@type": "Question",
      "name": "Can you keep parts of my existing garden?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Plenty of projects keep what's already working — a mature tree, a good hedge, an established lawn — and rework the rest around it."
      }
    },
    {
      "@type": "Question",
      "name": "Is planting guaranteed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our 12-month workmanship guarantee covers all hard landscaping. Planting isn't covered, because how well plants establish depends on aftercare, weather and soil conditions we can't control — but we'll give you clear advice on looking after it."
      }
    },
    {
      "@type": "Question",
      "name": "How much does a garden design and build cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Every garden is different, so we price each project properly. What moves the price is the size of the space, the materials you choose, how much groundwork is needed and access. We visit, measure up and give you a fixed written quote — free, with no obligation."
      }
    },
    {
      "@type": "Question",
      "name": "Do you use subcontractors?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The landscaping itself is done by our own team. For specialist work such as electrics and plumbing we bring in trusted trades we have worked with for years — but we manage the project from start to finish and stay accountable for it."
      }
    }
  ]
}
</script>

<style>
  :root{--err:#C0392B;
    --ink:#23241F;
    --ink-2:#33352D;
    --cream:#F2EFE6;
    --cream-2:#EAE5D8;
    --cream-3:#DFD9CB;
    --moss:#5C6B4F;
    --moss-dark:#454F3B;
    --moss-light:#7C8A6C;
    --concrete:#A8A398;
    --line:rgba(35,36,31,0.12);
    --line-strong:rgba(35,36,31,0.22);
    --txt:#23241F;
    --txt-mut:rgba(35,36,31,0.62);
    --surface:#FAF7EF;
    --shadow-sm:0 2px 8px rgba(35,36,31,0.05);
    --shadow:0 8px 30px rgba(35,36,31,0.08);
    --shadow-lg:0 24px 60px rgba(35,36,31,0.12);
    --serif:'Lora',serif;
    --sans:'Plus Jakarta Sans',sans-serif;
    --mono:'Space Mono',monospace;
    --r:16px; --r-sm:10px; --r-lg:24px;
    --pad:clamp(20px,5vw,40px);
  }
  [data-theme="dark"]{color-scheme:dark;--err:#E4796A;
    --ink:#EDEBE3; --ink-2:#D8D5CA;
    --cream:#262722; --cream-2:#2E2F29; --cream-3:#383931;
    --moss:#9BAA88; --moss-dark:#B4C2A2; --moss-light:#8A9879;
    --concrete:#7A776E;
    --line:rgba(237,235,227,0.12); --line-strong:rgba(237,235,227,0.22);
    --txt:#EDEBE3; --txt-mut:rgba(237,235,227,0.60);
    --surface:#2E2F29;
    --shadow-sm:0 2px 8px rgba(0,0,0,0.3);
    --shadow:0 8px 30px rgba(0,0,0,0.4);
    --shadow-lg:0 24px 60px rgba(0,0,0,0.5);
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;overscroll-behavior-y:none;}
  @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto;} *{animation:none!important;transition:none!important;}}
  body{overscroll-behavior-y:none;background:var(--cream);color:var(--txt);font-family:var(--sans);line-height:1.55;-webkit-font-smoothing:antialiased;overflow-x:hidden;transition:background .4s,color .4s;}
  a{color:inherit;text-decoration:none;}
  img{display:block;max-width:100%;}
  h1,h2,h3,h4{font-family:var(--serif);font-weight:600;letter-spacing:-0.015em;line-height:1.08;}
  .wrap{max-width:1240px;margin:0 auto;padding:0 var(--pad);}
  .eyebrow{font-family:var(--sans);font-size:14px;letter-spacing:0.06em;text-transform:uppercase;color:var(--moss);font-weight:600;}

  .reveal{opacity:0;transform:translateY(12px);transition:opacity .6s ease,transform .6s ease;}
  .reveal.in{opacity:1;transform:none;}
  .reveal.d1{transition-delay:.08s;} .reveal.d2{transition-delay:.16s;} .reveal.d3{transition-delay:.24s;} .reveal.d4{transition-delay:.32s;}

  .btn{display:inline-flex;align-items:center;gap:9px;font-family:var(--sans);font-weight:600;font-size:15px;padding:14px 26px;border-radius:100px;border:1px solid transparent;cursor:pointer;transition:transform .2s,background .2s,box-shadow .2s;position:relative;overflow:hidden;}
  .btn:active{transform:scale(.97);}
  .btn-primary{background:var(--moss);color:#fff;box-shadow:var(--shadow-sm);}
  .btn-primary:hover{background:var(--moss-dark);box-shadow:var(--shadow);}
  .btn-dark{background:var(--ink);color:var(--cream);}
  .btn-dark:hover{background:var(--ink-2);}
  .btn-ghost{background:transparent;border-color:var(--line-strong);color:var(--txt);}
  .btn-ghost:hover{background:var(--cream-3);}
  .btn-lg{padding:17px 34px;font-size:16px;}
  .ripple{position:absolute;border-radius:50%;background:rgba(255,255,255,.4);transform:scale(0);animation:rip .6s linear;pointer-events:none;}
  @keyframes rip{to{transform:scale(3);opacity:0;}}

  .section{padding:clamp(80px,12vw,160px) 0;}
  main section[id],#quote,#work{scroll-margin-top:86px;}
  .section-head{max-width:640px;margin-bottom:clamp(36px,5vw,60px);}
  .section-head.center{margin-left:auto;margin-right:auto;text-align:center;}
  .section-head h2{font-size:clamp(30px,4.5vw,46px);margin-top:12px;}
  .section-head p{margin-top:16px;color:var(--txt-mut);font-size:17px;}
  .skip{position:absolute;left:-999px;top:0;background:var(--ink);color:var(--cream);padding:10px 16px;z-index:999;border-radius:0 0 var(--r-sm) 0;}
  .skip:focus{left:0;}

  .ti{font-family:'tabler-icons'!important;font-style:normal;-webkit-font-smoothing:antialiased;}

  header#nav{position:sticky;top:0;z-index:100;background:var(--cream);transition:background .4s,box-shadow .4s,border-color .4s;border-bottom:1px solid var(--line);}
  header#nav.scrolled{background:color-mix(in srgb, var(--cream) 82%, transparent);backdrop-filter:blur(14px);border-bottom-color:var(--line);box-shadow:var(--shadow-sm);}
  .nav-in{display:flex;align-items:center;height:74px;gap:24px;}
  section[id]{scroll-margin-top:90px;}
  .brand{flex-shrink:0;}
  .nav-links{margin:0 auto;}
  .brand{display:flex;align-items:center;gap:11px;color:var(--ink);}
  .brand svg{color:var(--ink);}
  .brand-mark{width:48px;height:48px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
  .brand-mark img{width:48px;height:48px;object-fit:contain;display:block;}
  .brand-foot .brand-mark{width:32px;height:32px;}
  .brand-foot .brand-mark img{width:32px;height:32px;}
  .brand-txt{font-family:var(--serif);font-weight:600;font-size:20px;}
  .brand-txt em{font-style:normal;color:var(--moss);}
  .nav-links{display:flex;gap:30px;font-size:15px;font-weight:500;}
  .nav-links a{color:var(--txt);opacity:.78;transition:opacity .2s;position:relative;}
  .nav-links a:hover{opacity:1;}
  .nav-links a::after{content:'';position:absolute;left:0;bottom:-6px;width:0;height:2px;background:var(--moss);transition:width .25s;border-radius:2px;}
  .nav-links a:hover::after{width:100%;}
  .nav-cta{display:flex;align-items:center;gap:10px;}
  .nav-call{padding:11px 18px;}
  .burger{display:none;flex-direction:column;justify-content:center;gap:5px;background:none;border:none;cursor:pointer;padding:8px;min-width:44px;min-height:44px;align-items:center;}
  .burger span{width:24px;height:2px;background:var(--ink);border-radius:2px;transition:.3s;}
  .burger.open span:nth-child(1){transform:translateY(7px) rotate(45deg);}
  .burger.open span:nth-child(2){opacity:0;}
  .burger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg);}
  @media(max-width:1080px){.nav-links{display:none;}.nav-call{display:none;}.nav-cta{margin-left:auto;}.burger{margin-left:6px;}}
  @media(max-width:1080px){.burger{display:flex;}}

  .mobile-menu{position:fixed;inset:0;top:0;background:var(--cream);z-index:99;display:flex;flex-direction:column;gap:8px;padding:100px 32px 40px;transform:translateX(100%);transition:transform .4s cubic-bezier(.4,0,.2,1);}
  .mobile-menu.open{transform:none;}
  .mobile-menu a:not(.btn){font-family:var(--serif);font-size:26px;padding:12px 0;border-bottom:1px solid var(--line);}
  .mobile-menu .btn{margin-top:10px;justify-content:center;}

  .hero{position:relative;height:100vh;}
  .hero-bg{position:fixed;inset:0;z-index:-1;}
  .hero-bg img{width:100%;height:100%;object-fit:cover;}
  .hero-overlay{position:absolute;inset:0;background:linear-gradient(to top, rgba(35,36,31,.78), rgba(35,36,31,.3) 50%, rgba(35,36,31,.45));}
  .hero-in{position:relative;z-index:2;display:flex;align-items:flex-start;height:100vh;padding-top:clamp(80px,10vh,120px);}
  .hero-content{max-width:720px;color:#fff;padding:40px 0;}
  .hero-eyebrow{font-family:var(--mono);font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:#D9E0CE;display:inline-block;margin-bottom:20px;padding:7px 14px;border:1px solid rgba(255,255,255,.25);border-radius:100px;background:rgba(255,255,255,.06);backdrop-filter:blur(4px);}
  .hero h1{font-size:clamp(40px,6.8vw,74px);color:#fff;font-weight:700;letter-spacing:-0.01em;}
  .hero-kicker{display:block;font-family:var(--sans);font-size:15px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;line-height:1.4;color:rgba(255,255,255,.88);margin-bottom:18px;}
  .hero-sub{font-size:clamp(17px,2.2vw,21px);margin:24px 0 34px;max-width:560px;color:rgba(255,255,255,.9);line-height:1.5;}
  .hero-ctas{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:38px;}
  .hero-ghost{color:#fff;border-color:rgba(255,255,255,.4);backdrop-filter:blur(4px);}
  .hero-ghost:hover{background:rgba(255,255,255,.12);}
  .hero-trust{display:flex;align-items:center;gap:24px;flex-wrap:wrap;}
  .ht-google{display:flex;align-items:center;gap:12px;background:rgba(255,255,255,.95);padding:12px 18px;border-radius:var(--r);box-shadow:var(--shadow);}
  .htg-mark{width:38px;height:38px;border-radius:50%;background:conic-gradient(#EA4335 0 25%,#FBBC05 0 50%,#34A853 0 75%,#4285F4 0);display:flex;align-items:center;justify-content:center;font-weight:700;color:#fff;font-family:var(--sans);font-size:18px;position:relative;}
  .htg-mark::after{content:'';position:absolute;inset:6px;background:#fff;border-radius:50%;}
  .htg-mark{color:transparent;}
  .htg-stars{color:#E8A93B;display:flex;align-items:center;gap:2px;font-size:14px;color:#1a1a1a;}
  .htg-stars i{color:#E8A93B;font-size:14px;}
  .htg-stars strong{margin-left:5px;color:#1a1a1a;}
  .htg-sub{font-size:12px;color:#555;}
  .ht-badges{display:flex;gap:14px;flex-wrap:wrap;}
  .ht-badges span{display:flex;align-items:center;gap:7px;font-size:14px;font-weight:500;color:#fff;}
  .ht-badges i{color:#C4D2AC;font-size:18px;}

  .hero-stats{position:absolute;bottom:clamp(100px,14vh,160px);left:0;right:0;z-index:2;display:grid;grid-template-columns:repeat(4,1fr);gap:14px;padding:0 var(--pad);max-width:1240px;margin:0 auto;}
  .hs{display:flex;flex-direction:column;align-items:flex-start;color:#fff;min-width:0;padding:16px 18px;border-radius:var(--r);background:rgba(35,36,31,.42);border:1px solid rgba(255,255,255,.14);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);}
  .hs-num{font-family:var(--serif);font-size:clamp(30px,4vw,44px);font-weight:600;line-height:1;}
  .hs-suf{font-family:var(--serif);font-size:20px;color:#C4D2AC;margin-top:-6px;}
  .hs-lab{font-family:var(--mono);font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:rgba(255,255,255,.7);margin-top:8px;}


  .scroll-ind{position:absolute;bottom:18px;left:50%;transform:translateX(-50%);z-index:3;width:26px;height:42px;border:2px solid rgba(255,255,255,.5);border-radius:14px;display:flex;justify-content:center;padding-top:7px;}
  .scroll-ind span{width:3px;height:8px;background:#fff;border-radius:2px;animation:scrolldot 1.6s infinite;}
  @keyframes scrolldot{0%{opacity:0;transform:translateY(0);}40%{opacity:1;}80%{opacity:0;transform:translateY(12px);}}

  .logos{padding:36px 0;border-bottom:1px solid var(--line);background:var(--cream);}
  .logos-in{display:flex;flex-direction:column;align-items:center;gap:16px;text-align:center;}
  .logos-lab{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--txt-mut);}
  .logos-row{display:flex;gap:34px;flex-wrap:wrap;justify-content:center;align-items:center;}
  .acc{font-family:var(--serif);font-size:19px;font-weight:600;color:var(--txt);opacity:.55;}
  .logos-note{font-size:11px;color:var(--txt-mut);font-style:italic;}

  .sec-alt{background:var(--cream);}
  [data-theme="dark"] .sec-alt{background:var(--cream-2);}

  .ivy-drape{display:block;width:100%;height:auto;pointer-events:none;user-select:none;margin-top:calc(-1 * clamp(80px,12vw,160px));margin-bottom:-30vw;position:relative;z-index:0;-webkit-mask-image:linear-gradient(to bottom,transparent 0%,black 22%);mask-image:linear-gradient(to bottom,transparent 0%,black 22%);}
  #work > .wrap{position:relative;z-index:1;}


  .ba-feature{display:grid;grid-template-columns:1fr 0.95fr;gap:32px;align-items:center;background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);padding:18px;box-shadow:var(--shadow);margin-bottom:54px;}
  .ba-slider{position:relative;width:100%;aspect-ratio:3/4;overflow:hidden;cursor:ew-resize;user-select:none;border-radius:var(--r);}
  .ba-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
  .ba-after{clip-path:inset(0 50% 0 0);}
  .ba-tag{position:absolute;top:14px;font-family:var(--sans);font-weight:600;font-size:11px;letter-spacing:.05em;text-transform:uppercase;color:#fff;padding:6px 11px;border-radius:100px;z-index:3;backdrop-filter:blur(4px);}
  .ba-slider .ba-tag{transition:opacity .25s ease,transform .25s ease;}
  .ba-slider .ba-tag.is-hidden{opacity:0;transform:translateY(-6px);pointer-events:none;}
  .ba-tag-b{left:14px;background:rgba(35,36,31,.7);}
  .ba-tag-a{right:14px;background:rgba(92,107,79,.85);}
  .ba-line{position:absolute;top:0;bottom:0;left:50%;width:2px;background:#fff;z-index:4;pointer-events:none;box-shadow:0 0 10px rgba(0,0,0,.3);}
  .ba-handle{position:absolute;top:50%;left:50%;width:48px;height:48px;background:#fff;border-radius:50%;transform:translate(-50%,-50%);z-index:5;display:flex;align-items:center;justify-content:center;color:var(--ink);font-size:22px;box-shadow:var(--shadow);cursor:ew-resize;}
  .ba-info{padding:14px 14px 14px 6px;display:flex;flex-direction:column;}
  .ba-info h3{font-size:25px;}
  .ba-loc{display:flex;align-items:center;gap:6px;color:var(--moss);font-size:14px;margin:6px 0 16px;font-weight:500;}
  .ba-meta{list-style:none;display:flex;flex-direction:column;gap:0;margin-bottom:18px;}
  .ba-meta li{display:flex;justify-content:space-between;align-items:baseline;padding:10px 0;border-top:1px solid var(--line);font-size:14px;gap:14px;}
  .ba-meta span{color:var(--txt-mut);}
  .ba-meta strong{font-weight:600;text-align:right;}
  .ba-quote{font-family:var(--serif);font-size:16px;line-height:1.45;color:var(--txt);border-left:3px solid var(--moss);padding-left:16px;margin-bottom:20px;}
  .ba-quote cite{display:block;font-family:var(--sans);font-size:12.5px;font-style:normal;color:var(--txt-mut);margin-top:8px;}
  .ba-info .btn{margin-top:auto;align-self:flex-start;}


  .work-block{margin:0 0 22px;}
  .work-sub{font-size:clamp(22px,3vw,29px);}
  .work-note{color:var(--txt-mut);font-size:15px;margin-top:6px;}
  .work-divider{height:1px;background:var(--line);margin:56px 0;}

  .reveal-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}


  .rcard{position:relative;border-radius:var(--r);overflow:hidden;aspect-ratio:1/1;cursor:pointer;box-shadow:var(--shadow-sm);outline:none;}
  .rcard:focus-visible{box-shadow:0 0 0 3px var(--moss);}
  .rcard img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
  .rcard .r-after{opacity:0;transition:opacity .45s ease;z-index:2;}
  .rcard.show .r-after{opacity:1;}
  .r-tag{position:absolute;top:12px;left:12px;z-index:3;font-family:var(--mono);font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:#fff;padding:6px 11px;border-radius:100px;backdrop-filter:blur(4px);transition:opacity .3s;}
  .r-tag-after{background:rgba(92,107,79,.85);opacity:0;}
  .r-tag-before{background:rgba(35,36,31,.72);}
  .rcard.show .r-tag-after{opacity:1;}
  .rcard.show .r-tag-before{opacity:0;}
  .r-hint{position:absolute;bottom:12px;right:12px;z-index:3;font-family:var(--mono);font-size:10px;color:#fff;background:rgba(35,36,31,.5);padding:5px 10px;border-radius:100px;backdrop-filter:blur(4px);transition:opacity .3s;}
  .rcard.show .r-hint{opacity:0;}
  /* hover effects only where a real pointer exists — on touch, :hover latches after a tap */
  @media (hover:hover){
    .rcard:hover .r-after{opacity:1;}
    .rcard:hover .r-tag-after{opacity:1;}
    .rcard:hover .r-tag-before{opacity:0;}
    .rcard:hover .r-hint{opacity:0;}
  }
  .rcard-cap{display:flex;justify-content:space-between;align-items:baseline;padding-top:11px;gap:10px;}
  .rcard-cap strong{font-family:var(--serif);font-size:17px;font-weight:600;}
  .rcard-cap span{font-family:var(--mono);font-size:11.5px;color:var(--txt-mut);white-space:nowrap;}

  .finished-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:30px 32px;}
  :root{--stack-1:#D4D8C8;--stack-2:#B7BEA9;}
  [data-theme="dark"]{--stack-1:#33372E;--stack-2:#262A22;}


  .fcard{position:relative;border-radius:var(--r);overflow:hidden;aspect-ratio:1/1;cursor:pointer;box-shadow:5px 5px 0 0 var(--stack-1),10px 10px 0 0 var(--stack-2),var(--shadow-sm);transition:transform .35s,box-shadow .35s;}
  .fcard:focus-visible{outline:none;box-shadow:0 0 0 3px var(--moss),5px 5px 0 0 var(--stack-1),10px 10px 0 0 var(--stack-2),var(--shadow-sm);}
  @media (hover:hover){
    .fcard:hover{transform:translateY(-4px);box-shadow:7px 9px 0 0 var(--stack-1),14px 18px 0 0 var(--stack-2),var(--shadow-lg);}
    .fcard:hover img{transform:scale(1.06);}
    .fcard:hover .fcard-ov{opacity:1;}
  }
  .fcard img{width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.2,.7,.3,1);}
  .fcard-ov{position:absolute;inset:0;background:linear-gradient(to top,rgba(35,36,31,.72),transparent 52%);opacity:0;transition:opacity .35s;display:flex;align-items:flex-end;padding:16px;color:#fff;font-family:var(--serif);font-size:17px;}
  .fcard-count{position:absolute;top:12px;right:12px;z-index:3;display:flex;align-items:center;gap:6px;font-family:var(--sans);font-weight:700;font-size:12.5px;letter-spacing:.01em;color:#23241F;background:rgba(255,255,255,.96);padding:7px 12px;border-radius:100px;box-shadow:0 2px 8px rgba(0,0,0,.20);}
  .fcard-count svg{width:15px;height:15px;stroke:#5C6B4F;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex:none;}
  .fcard-dots{position:absolute;right:12px;bottom:12px;z-index:3;display:flex;gap:5px;align-items:center;background:rgba(35,36,31,.55);padding:6px 9px;border-radius:100px;backdrop-filter:blur(4px);}
  .fcard-dots i{width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,.55);transition:width .25s,background .25s;}
  .fcard-dots i.on{background:#fff;width:16px;border-radius:3px;}
  .fcard-ov{padding-right:96px;}
  .lb-detail{display:block;color:rgba(255,255,255,.65);font-family:var(--sans);font-weight:400;font-size:13px;margin-top:9px;letter-spacing:0;}

  .svc-list{display:flex;flex-direction:column;gap:24px;}
  .svc{display:grid;grid-template-columns:1fr 1fr;gap:0;background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);overflow:hidden;box-shadow:var(--shadow-sm);}
  .svc:nth-child(even) .svc-media{order:2;}
  .svc-media{position:relative;min-height:320px;background:linear-gradient(135deg,var(--cream-3),var(--concrete));display:flex;align-items:center;justify-content:center;}
  .svc-media span{font-family:var(--mono);font-size:12px;color:rgba(35,36,31,.5);text-transform:uppercase;letter-spacing:.05em;}
  .svc-media .ti{position:absolute;font-size:60px;color:rgba(255,255,255,.55);}
  .svc-body{padding:clamp(28px,4vw,46px);display:flex;flex-direction:column;justify-content:center;}
  .svc-body .eyebrow{margin-bottom:10px;}
  .svc-body h3{font-size:clamp(24px,3vw,32px);margin-bottom:12px;}
  .svc-body>p{color:var(--txt-mut);margin-bottom:20px;font-size:16px;}
  .svc-incl{list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:9px 16px;margin-bottom:24px;}
  .svc-incl li{display:flex;align-items:flex-start;gap:8px;font-size:14.5px;}
  .svc-incl i{color:var(--moss);font-size:17px;flex-shrink:0;margin-top:1px;}
  .svc-foot{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;}
  .svc-price{font-size:14px;color:var(--txt-mut);}
  .svc-price strong{font-family:var(--serif);font-size:20px;color:var(--txt);font-weight:600;display:block;}


  .trust-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;}


  .sec-dark{background:var(--ink);color:var(--cream);}
  .sec-dark .eyebrow.light{color:var(--moss-light);}
  .light-mut{color:rgba(237,235,227,.62)!important;}
  [data-theme="dark"] .sec-dark{background:#101109;}



  .video-testimonial{display:grid;grid-template-columns:1.2fr 1fr;gap:30px;margin-top:48px;background:rgba(237,235,227,.06);border:1px solid rgba(237,235,227,.14);border-radius:var(--r-lg);overflow:hidden;align-items:center;}
  .vt-thumb{position:relative;min-height:280px;background:linear-gradient(135deg,#3A4433,#5C6B4F);display:flex;align-items:flex-end;justify-content:center;padding:20px;}
  .vt-thumb span{font-family:var(--mono);font-size:12px;color:rgba(255,255,255,.7);}
  .vt-play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:72px;height:72px;border-radius:50%;background:rgba(255,255,255,.95);border:none;color:var(--ink);font-size:30px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:transform .2s;box-shadow:var(--shadow);}
  .vt-play:hover{transform:translate(-50%,-50%) scale(1.08);}
  .vt-text{padding:30px 34px;}
  .vt-text h3{font-size:24px;margin-bottom:12px;}
  .vt-text p{color:rgba(237,235,227,.7);font-size:15px;margin-bottom:14px;}
  .vt-name{font-family:var(--mono);font-size:12px;color:var(--moss-light);text-transform:uppercase;letter-spacing:.05em;}


  .timeline{position:relative;display:flex;flex-direction:column;gap:8px;}
  .tl-item{display:grid;grid-template-columns:64px 1fr;gap:24px;padding:8px 0;position:relative;}
  .tl-rail{display:flex;flex-direction:column;align-items:center;}
  .tl-dot{width:56px;height:56px;border-radius:50%;background:var(--surface);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;font-size:24px;color:var(--moss);box-shadow:var(--shadow-sm);flex-shrink:0;z-index:2;transition:background .4s,color .4s,transform .4s;}
  .tl-item.in .tl-dot{background:var(--moss);color:#fff;transform:scale(1.05);}
  .tl-conn{width:2px;flex:1;background:var(--line);margin:6px 0;}
  .tl-item:last-child .tl-conn{display:none;}
  .tl-body{padding:4px 0 30px;}
  .tl-num{font-family:var(--mono);font-size:12px;color:var(--moss);letter-spacing:.05em;}
  .tl-body h3{font-size:22px;margin:4px 0 8px;}
  .tl-body p{color:var(--txt-mut);font-size:15px;max-width:560px;}
  .tl-time{display:inline-flex;align-items:center;gap:6px;margin-top:10px;font-size:13px;font-weight:500;color:var(--txt);background:var(--cream-3);padding:5px 12px;border-radius:100px;}

  .about-grid{display:grid;grid-template-columns:1fr;gap:clamp(30px,5vw,64px);align-items:center;justify-items:center;}
  .about-text{max-width:640px;}
  .about-text h2{font-size:clamp(28px,4vw,40px);margin:12px 0 16px;}
  .about-text>p{color:var(--txt-mut);font-size:16px;margin-bottom:14px;}
  .about-values{display:flex;flex-direction:column;gap:14px;margin:24px 0 28px;}
  .about-values>div{display:grid;grid-template-columns:auto 1fr;column-gap:14px;align-items:center;}
  .about-values i{grid-row:span 2;font-size:26px;color:var(--moss);background:var(--cream-3);width:50px;height:50px;border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;}
  .about-values strong{font-size:15px;}
  .about-values span{font-size:13.5px;color:var(--txt-mut);}


  .areas-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px;}
  .area{display:flex;align-items:center;justify-content:space-between;padding:16px 18px;background:var(--surface);border:1px solid var(--line);border-radius:var(--r-sm);font-size:15px;font-weight:500;transition:.2s;}
  .area:hover{border-color:var(--moss);color:var(--moss);transform:translateX(3px);}
  .area i{color:var(--moss);font-size:17px;opacity:.6;}
  .area:hover i{opacity:1;}

  .faq-wrap{max-width:860px;}
  .faq-list{display:flex;flex-direction:column;gap:10px;}
  .faq-item{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;}
  .faq-q{width:100%;text-align:left;background:none;border:none;cursor:pointer;padding:20px 24px;font-family:var(--sans);font-size:16.5px;font-weight:500;color:var(--txt);display:flex;justify-content:space-between;align-items:center;gap:16px;}
  .faq-q i{flex-shrink:0;font-size:20px;color:var(--moss);transition:transform .3s;}
  .faq-item.open .faq-q i{transform:rotate(45deg);}
  .faq-a{max-height:0;overflow:hidden;transition:max-height .35s ease;}
  .faq-a p{padding:0 24px 22px;color:var(--txt-mut);font-size:15px;line-height:1.6;}

  .quote-sec{background:var(--cream);}
  [data-theme="dark"] .quote-sec{background:var(--cream-2);}
  #quote canvas{opacity:.35;}
  .quote-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:clamp(30px,5vw,60px);align-items:start;}
  .quote-intro h2{font-size:clamp(28px,4vw,42px);margin:12px 0 16px;}
  .quote-intro>p{color:var(--txt-mut);font-size:16px;margin-bottom:24px;}
  .quote-points{list-style:none;display:flex;flex-direction:column;gap:11px;margin-bottom:28px;}
  .quote-points li{display:flex;align-items:center;gap:10px;font-size:15px;}
  .quote-points i{color:#fff;background:var(--moss);width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;}
  .quote-contact{display:flex;flex-direction:column;gap:12px;padding-top:24px;border-top:1px solid var(--line);}
  .quote-contact a,.quote-contact span{display:flex;align-items:center;gap:10px;font-size:15px;font-weight:500;min-height:32px;}
  .quote-contact i{color:var(--moss);font-size:19px;}
  /* Hover on the two contact links — pointer devices only, so a tap doesn't latch it */
  .quote-contact a{color:inherit;transition:color .25s ease,transform .25s ease;}
  .quote-contact a svg{flex:none;transition:transform .35s cubic-bezier(.2,.7,.3,1),color .25s ease;}
  @media(hover:hover){
    .quote-contact a:hover{color:var(--moss-dark);transform:translateX(3px);}
    .quote-contact a:hover svg{color:var(--moss);}
    .quote-contact a[href^="tel:"]:hover svg{animation:qc-ring .65s ease;}
    .quote-contact a[href^="mailto:"]:hover svg{transform:translateY(-3px) scale(1.1);}
  }
  .quote-contact a:focus-visible{color:var(--moss-dark);transform:translateX(3px);}
  @keyframes qc-ring{0%,100%{transform:rotate(0);}15%{transform:rotate(-15deg);}30%{transform:rotate(13deg);}45%{transform:rotate(-9deg);}60%{transform:rotate(6deg);}75%{transform:rotate(-3deg);}}

  .quote-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);padding:clamp(24px,3vw,38px);box-shadow:var(--shadow-lg);position:relative;}
  .qsteps{margin-bottom:26px;}
  .qstep-bar{height:6px;background:var(--cream-3);border-radius:100px;overflow:hidden;margin-bottom:10px;}
  .qstep-bar span{display:block;height:100%;width:25%;background:var(--moss);border-radius:100px;transition:width .4s cubic-bezier(.4,0,.2,1);}
  .qstep-lab{font-family:var(--mono);font-size:12px;color:var(--txt-mut);text-transform:uppercase;letter-spacing:.04em;}
  .qpanel{display:none;animation:qfade .4s;}
  .qpanel.active{display:block;}
  @keyframes qfade{from{opacity:0;transform:translateX(12px);}to{opacity:1;transform:none;}}
  .qlabel{display:block;font-weight:600;font-size:15px;margin:0 0 14px;}
  .qlabel span{font-weight:400;color:var(--txt-mut);font-size:13px;}
  .qchips{display:flex;flex-wrap:wrap;gap:10px;}
  .qchip{padding:11px 18px;border:1px solid var(--line-strong);border-radius:100px;font-size:14.5px;cursor:pointer;transition:.2s;user-select:none;display:flex;align-items:center;gap:7px;font-family:var(--sans);background:none;color:var(--txt);line-height:1.3;}
  .qchip:focus-visible,.qradio:focus-within{outline:3px solid var(--moss);outline-offset:2px;}
  .qchip:hover{border-color:var(--moss);}
  .qchip.sel{background:var(--moss);color:#fff;border-color:var(--moss);}
  .qchip i{font-size:16px;}
  .qradios{display:flex;flex-direction:column;gap:10px;}
  .qradio input{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none;}
  .qradio{padding:15px 18px;border:1px solid var(--line-strong);border-radius:var(--r-sm);font-size:15px;cursor:pointer;transition:.2s;display:flex;align-items:center;gap:12px;}
  .qradio:hover{border-color:var(--moss);}
  .qradio.sel{border-color:var(--moss);background:color-mix(in srgb,var(--moss) 8%,transparent);}
  .qradio .dot{width:18px;height:18px;border-radius:50%;border:2px solid var(--line-strong);flex-shrink:0;transition:.2s;}
  .qradio.sel .dot{border-color:var(--moss);background:var(--moss);box-shadow:inset 0 0 0 3px var(--surface);}
  .qupload{display:flex;align-items:center;gap:12px;padding:18px;border:2px dashed var(--line-strong);border-radius:var(--r-sm);cursor:pointer;color:var(--txt-mut);font-size:14.5px;transition:.2s;}
  .qupload:hover{border-color:var(--moss);color:var(--moss);}
  .qupload input{display:none;}
  .qupload i{font-size:24px;}
  .qfield{margin-bottom:14px;}
  .qfield label{display:block;font-size:13px;font-weight:500;margin-bottom:6px;color:var(--txt-mut);}
  .qfield-err{color:var(--err);font-size:12.5px;font-weight:500;margin:6px 0 0;}
  .qfield input,.qfield textarea{width:100%;padding:12px 14px;border:1px solid var(--line-strong);border-radius:var(--r-sm);font-family:var(--sans);font-size:15px;background:var(--cream);color:var(--txt);transition:.2s;}
  .qfield input:focus,.qfield textarea:focus{outline:none;border-color:var(--moss);box-shadow:0 0 0 3px color-mix(in srgb,var(--moss) 18%,transparent);}
  .qfield textarea{min-height:84px;resize:vertical;}
  .qrow{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  .qsummary{font-size:15.5px;font-weight:600;color:var(--txt);background:var(--cream-2);border-left:3px solid var(--moss);padding:14px 16px;border-radius:var(--r-sm);line-height:1.5;}
  .qnav{display:flex;justify-content:space-between;gap:12px;margin-top:24px;}
  .qdone{display:none;text-align:center;padding:30px 10px;}
  .qdone.show{display:block;animation:qfade .5s;}
  .qdone-ic{width:64px;height:64px;border-radius:50%;background:var(--moss);color:#fff;display:flex;align-items:center;justify-content:center;font-size:34px;margin:0 auto 18px;}
  .qdone h3{font-size:26px;margin-bottom:10px;}
  .qdone p{color:var(--txt-mut);font-size:15px;}
  .qdone a{color:var(--moss);font-weight:600;}


  .map-sec{background:var(--cream);}
  .map-grid{display:grid;grid-template-columns:1fr;}
  .map-vis{position:relative;min-height:340px;}
  .map-vis iframe{display:block;width:100%;height:100%;min-height:340px;}
  .map-pin{color:var(--moss);font-size:48px;animation:pinbob 2s ease-in-out infinite;}
  @keyframes pinbob{0%,100%{transform:translateY(0);}50%{transform:translateY(-8px);}}
  .map-info{padding:clamp(30px,5vw,56px);display:flex;flex-direction:column;justify-content:center;background:var(--ink);color:var(--cream);}
  .map-info h3{font-size:26px;margin-bottom:18px;color:var(--cream);}
  .mi-row{display:flex;align-items:flex-start;gap:11px;font-size:15px;margin-bottom:13px;color:rgba(237,235,227,.85);}
  .mi-row i{color:var(--moss-light);font-size:19px;flex-shrink:0;}
  .mi-row a{color:var(--cream);font-weight:500;}


  .footer{background:var(--ink);color:rgba(237,235,227,.7);padding:64px 0 0;}
  [data-theme="dark"] .footer{background:#101109;}
  .foot-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr 1.3fr;gap:36px;padding-bottom:44px;}
  .brand-foot{color:#EDEBE3;margin-bottom:16px;}
  .brand-foot svg{color:#EDEBE3;}
  .foot-brand p{font-size:14px;line-height:1.6;max-width:280px;margin-bottom:18px;}
  .foot-social{display:flex;gap:10px;}
  .foot-social a{width:40px;height:40px;border-radius:50%;border:1px solid rgba(237,235,227,.2);display:flex;align-items:center;justify-content:center;font-size:18px;color:var(--cream);transition:.2s;}
  .foot-social a:hover{background:var(--moss);border-color:var(--moss);}
  .foot-col h3{font-family:var(--sans);font-size:13px;text-transform:uppercase;letter-spacing:.06em;color:#EDEBE3;margin-bottom:16px;font-weight:600;}
  .foot-col a,.foot-col span{display:block;font-size:14px;margin-bottom:10px;color:rgba(237,235,227,.7);transition:.2s;}
  .foot-col a:hover{color:var(--moss-light);}
  .foot-contact a,.foot-contact span{display:flex;align-items:center;gap:9px;}
  .foot-contact i{color:var(--moss-light);font-size:17px;}
  .foot-acc{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;}
  .foot-acc span{font-family:var(--mono);font-size:10px;text-transform:uppercase;letter-spacing:.04em;border:1px solid rgba(237,235,227,.2);padding:5px 9px;border-radius:100px;margin:0;}
  .foot-bottom{display:flex;justify-content:space-between;align-items:center;padding:22px 0;border-top:1px solid rgba(237,235,227,.14);font-size:13px;flex-wrap:wrap;gap:12px;}
  .foot-legal{display:flex;gap:8px;flex-wrap:wrap;}
  .foot-legal a{display:inline-flex;align-items:center;min-height:44px;padding:0 10px;}
  .foot-legal a:hover{color:var(--moss-light);}



  .float-call,.float-quote{position:fixed;z-index:90;bottom:20px;box-shadow:var(--shadow-lg);transition:transform .2s;}
  .float-call{right:20px;width:56px;height:56px;border-radius:50%;background:var(--moss);color:#fff;display:none;align-items:center;justify-content:center;font-size:24px;}
  .float-quote{left:20px;right:84px;background:var(--ink);color:var(--cream);text-align:center;padding:16px;border-radius:100px;font-weight:600;font-size:16px;display:none;}
  .float-call:active,.float-quote:active{transform:scale(.95);}


  .lightbox{position:fixed;inset:0;z-index:200;background:rgba(20,20,18,.92);backdrop-filter:blur(8px);display:none;align-items:center;justify-content:center;padding:30px;}
  .lightbox.open{display:flex;animation:qfade .3s;}
  .lb-fig{max-width:1000px;width:100%;text-align:center;}
  .lb-view{--lb-gap:18px;width:100%;overflow:hidden;touch-action:pan-y;}
  .lb-track{display:flex;width:100%;gap:var(--lb-gap);will-change:transform;}
  .lb-slide{flex:0 0 100%;width:100%;display:flex;align-items:center;justify-content:center;}
  /* The img shrinks to the photo itself, so the radius clips the picture, not empty box */
  .lb-slide img{max-width:100%;max-height:78vh;width:auto;height:auto;object-fit:contain;border-radius:var(--r-lg);display:block;}
  .lb-fig figcaption{color:#fff;font-family:var(--serif);font-weight:600;font-size:clamp(17px,2.2vw,20px);margin-top:16px;letter-spacing:0;}
  .lb-close,.lb-prev,.lb-next{position:absolute;z-index:3;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);color:#fff;width:50px;height:50px;border-radius:50%;cursor:pointer;font-size:22px;display:flex;align-items:center;justify-content:center;transition:.2s;}
  .lb-close:hover,.lb-prev:hover,.lb-next:hover{background:rgba(255,255,255,.25);}
  .lb-close{top:24px;right:24px;}
  .lb-prev{left:24px;top:50%;transform:translateY(-50%);}
  .lb-next{right:24px;top:50%;transform:translateY(-50%);}

  /* --- mobile refinements --- */






  /* finished-project video feature */
  .video-feature{display:grid;grid-template-columns:1fr auto;gap:clamp(28px,5vw,64px);align-items:center;margin-bottom:54px;}
  .vf-copy{max-width:460px;background:rgba(28,29,24,.55);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);padding:28px 32px;border-radius:var(--r-lg);}
  .vf-copy .work-sub{margin:6px 0 12px;}
  .vf-copy p{margin:0 0 24px;}
  .reel{width:350px;max-width:100%;border-radius:24px;overflow:hidden;box-shadow:var(--shadow-lg);background:#000;line-height:0;border:1px solid var(--line);}
  .reel iframe{display:block;width:350px;height:625px;border:0;}




  /* Float buttons visible on mobile */
  @media(max-width:768px){.float-call{display:flex;}.float-quote{display:block;}}

  /* ═══════════════════════════════════════════════════════
     MOBILE-FIRST RESPONSIVE SYSTEM
     Base: 320–480px (small phones)
     ≥ 481px: large phones
     ≥ 601px: small tablets
     ≥ 769px: tablets / small laptops
     ≥ 1081px: desktop (nav breakpoint)
     ═══════════════════════════════════════════════════════ */

  /* ── Small phones (base / ≤480px) ── */
  @media(max-width:480px){
    :root{--pad:20px;}
    body{font-size:15px;line-height:1.6;}
    h1{font-size:clamp(32px,9vw,42px);}
    h2{font-size:clamp(24px,7vw,32px);line-height:1.14;}
    h3{font-size:clamp(18px,5vw,22px);line-height:1.2;}

    .section{padding:56px 0;}
    .section-head{margin-bottom:28px;}
    .section-head h2{margin-top:8px;}
    .section-head p{font-size:15px;line-height:1.6;}
    .eyebrow{font-size:11px;letter-spacing:0.12em;margin-bottom:8px;}

    /* Nav — hide CTA, compact layout, taller touch target */
    .nav-cta{gap:6px;flex-shrink:0;}
    .brand{min-width:0;overflow:hidden;}
    .brand-txt{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
    .nav-cta .btn-primary{display:none;}
    header#nav{overflow-x:hidden;}
    .nav-in{height:62px;gap:8px;}
    .burger{margin-left:0;}
    .brand-txt{font-size:16px;}
    .burger{padding:10px;}
    .burger span{width:22px;}

    /* Mobile menu — bigger tap targets */
    .mobile-menu{padding:80px 24px 32px;}
    .mobile-menu a:not(.btn){font-size:22px;padding:16px 0;min-height:52px;display:flex;align-items:center;}
    .mobile-menu .btn{min-height:52px;font-size:16px;padding:16px 24px;}

    /* Ivy drape — match the 56px mobile section padding */
    .ivy-drape{margin-top:-56px;}

    /* Hero — readable without zoom */
    .hero{height:100svh;}
    .hero-content{padding:24px 0;}
    .hero h1{font-size:clamp(32px,9vw,42px);line-height:1.06;}
    .hero-kicker{font-size:11px;letter-spacing:0.07em;margin-bottom:12px;}
    .hero-sub{font-size:16px;margin:18px 0 26px;line-height:1.55;}
    .hero-ctas{flex-direction:column;align-items:stretch;gap:10px;}
    .hero-ctas .btn{width:100%;justify-content:center;padding:16px 24px;font-size:16px;min-height:52px;}
    .hero-trust{gap:14px;}
    .ht-google{padding:10px 14px;}
    .htg-stars{font-size:13px;}
    .ht-badges span{font-size:13px;}

    /* Phones: hidden — the floating call/quote buttons sit in this space */
    .hero-stats{display:none;}
    .hs{padding:8px 7px;border-radius:var(--r-sm);align-items:center;text-align:center;}
    .hs-num{font-size:clamp(17px,4.8vw,21px);}
    .hs-suf{font-size:11px;margin-top:-1px;}
    .hs-lab{font-size:8px;margin-top:4px;letter-spacing:.04em;line-height:1.25;}

    /* Video feature — stack on mobile */
    .video-feature{gap:20px;margin-bottom:36px;grid-template-columns:1fr;}
    .vf-copy{max-width:100%;padding:20px 20px;}
    .vf-copy .work-sub{font-size:20px;}
    .reel{width:100%;max-width:100%;}
    .reel iframe{width:100%;max-width:100%;height:480px;}

    /* Before/after */
    .ba-feature{grid-template-columns:1fr;gap:20px;padding:14px;}
    .ba-slider{aspect-ratio:4/5;}
    .ba-handle{width:42px;height:42px;}
    .ba-info{padding:10px 4px 4px;}
    .ba-info h3{font-size:21px;}
    .ba-meta li{font-size:13.5px;padding:9px 0;}
    .ba-quote{font-size:15px;padding-left:14px;}
    .ba-info .btn{width:100%;justify-content:center;min-height:50px;}

    /* Reveal cards */
    .reveal-grid{grid-template-columns:1fr;gap:18px;}
    .rcard{aspect-ratio:4/3;}
    .rcard-cap{padding:10px 0;flex-direction:column;gap:2px;text-align:center;}
    .rcard-cap strong{font-size:16px;}
    .r-hint{font-size:11px;padding:6px 12px;}
    .work-block{text-align:left;}
    .work-sub{font-size:20px;}
    .work-note{font-size:14px;}

    /* Finished grid */
    .finished-grid{grid-template-columns:1fr;gap:18px;}
    .fcard{aspect-ratio:4/3;border-radius:14px;}
    .fcard-ov{font-size:15px;padding:14px 92px 14px 14px;opacity:1;}

    /* Services */
    .svc{grid-template-columns:1fr;}
    .svc:nth-child(even) .svc-media{order:0;}
    .svc-media{min-height:220px;}
    .svc-body{padding:24px 20px;}
    .svc-body h3{font-size:22px;}
    .svc-body>p{font-size:15px;}
    .svc-incl{grid-template-columns:1fr;gap:8px;}
    .svc-incl li{font-size:14px;min-height:36px;align-items:center;}
    .svc-foot{flex-direction:column;align-items:stretch;}
    .svc-foot .btn{width:100%;justify-content:center;min-height:50px;}

    /* Trust */
    .trust-grid{grid-template-columns:1fr;gap:14px;}


    /* About */
    .about-grid{gap:32px;}
    .about-text h2{font-size:clamp(24px,7vw,32px);}
    .about-text>p{font-size:15px;line-height:1.65;}
    .about-values>div{column-gap:12px;}
    .about-values i{width:44px;height:44px;font-size:22px;}
    .about-values strong{font-size:14px;}
    .about-values span{font-size:13px;}

    /* Process timeline */
    .tl-item{grid-template-columns:48px 1fr;gap:16px;}
    .tl-dot{width:44px;height:44px;font-size:20px;}
    .tl-body h3{font-size:19px;}
    .tl-body p{font-size:14px;}
    .tl-time{font-size:12px;padding:4px 10px;}

    /* FAQ — bigger tap targets */
    .faq-q{padding:18px 16px;font-size:16px;min-height:56px;}
    .faq-a p{padding:0 16px 18px;font-size:14.5px;}

    /* Quote form */
    .quote-grid{grid-template-columns:1fr;}
    .quote-intro h2{font-size:clamp(24px,7vw,32px);}
    .quote-intro>p{font-size:15px;}
    .quote-card{padding:20px;border-radius:var(--r);}
    .qchip{padding:12px 16px;font-size:14px;min-height:46px;}
    .qradio{padding:14px 16px;font-size:15px;min-height:50px;}
    .qfield input,.qfield textarea{padding:14px;font-size:16px;min-height:50px;}
    .qfield textarea{min-height:100px;}
    .qrow{grid-template-columns:1fr;}
    .qnav{flex-direction:column;gap:10px;}
    .qnav .btn{width:100%;justify-content:center;min-height:50px;}
    .qupload{padding:20px;font-size:14px;min-height:56px;justify-content:center;}

    /* Map */
    .map-grid{grid-template-columns:1fr;}
    .map-vis{min-height:260px;}
    .map-vis iframe{min-height:260px;}
    .map-info{padding:28px 20px;}
    .map-info h3{font-size:22px;}

    /* Footer */
    .footer{padding:44px 0 0;}
    .foot-grid{grid-template-columns:1fr;gap:28px;padding-bottom:32px;}
    .foot-brand p{font-size:14px;}
    .foot-social a{width:46px;height:46px;font-size:20px;}
    .foot-col h3{font-size:12px;margin-bottom:12px;}
    .foot-col a,.foot-col span{font-size:14px;margin-bottom:12px;min-height:36px;display:flex;align-items:center;}
    .foot-bottom{flex-direction:column;align-items:flex-start;gap:8px;padding:18px 0;padding-bottom:100px;}
    .foot-legal{gap:16px;}

    /* Floating buttons — bigger tap targets */
    .float-call{width:60px;height:60px;font-size:26px;bottom:16px;right:16px;}
    .float-quote{left:16px;right:84px;bottom:16px;padding:17px;font-size:15px;min-height:52px;display:flex;align-items:center;justify-content:center;}

    /* Lightbox */
    .lightbox{padding:12px;}
    .lb-close{top:10px;right:10px;width:46px;height:46px;background:rgba(20,20,18,.6);border-color:rgba(255,255,255,.4);}
    .lb-prev,.lb-next{width:54px;height:54px;font-size:24px;background:rgba(20,20,18,.62);border-color:rgba(255,255,255,.45);box-shadow:0 3px 14px rgba(0,0,0,.45);}
    .lb-prev:active,.lb-next:active{background:rgba(20,20,18,.85);transform:translateY(-50%) scale(.94);}
    .lb-prev{left:8px;} .lb-next{right:8px;}
    .lb-view{--lb-gap:12px;}
    .lb-slide img{border-radius:var(--r);}

    /* Areas grid */
    .areas-grid{grid-template-columns:1fr;gap:10px;}
    .area{padding:16px;min-height:52px;font-size:15px;}

    /* General touch targets — ensure minimum 44px */
    .btn{min-height:48px;}
    .btn-lg{min-height:54px;}
  }

  /* ── Large phones (481–600px) ── */
  @media(min-width:481px) and (max-width:600px){
    .foot-grid{grid-template-columns:1fr 1fr;gap:28px;}
    .quote-grid{grid-template-columns:1fr;}
    .hero-ctas{flex-direction:row;flex-wrap:wrap;}
    .hero-ctas .btn{flex:1;min-width:140px;justify-content:center;min-height:50px;}
    .reveal-grid{grid-template-columns:repeat(2,1fr);}
    .finished-grid{grid-template-columns:repeat(2,1fr);}
    .trust-grid{grid-template-columns:repeat(2,1fr);}
    .nav-cta .btn-primary{display:none;}
    .fcard-ov{opacity:1;}
  }

  /* Short desktop/laptop windows: shrink the tiles so they clear the badges */
  @media(min-width:481px) and (max-height:920px){
    .hero-stats{bottom:12px;gap:10px;}
    .hs{padding:7px 10px;border-radius:var(--r-sm);}
    .hs-num{font-size:clamp(19px,2.2vw,23px);}
    .hs-suf{font-size:13px;margin-top:-2px;}
    .hs-lab{font-size:9px;margin-top:4px;}
  }
  @media(min-width:481px) and (max-height:745px){
    .hero-stats{gap:8px;}
    .hs{padding:6px 9px;}
    .hs-num{font-size:19px;}
    .hs-lab{font-size:8.5px;margin-top:3px;}
  }
  /* Phones & tablets: the floating call & quote buttons own the bottom of the hero */
  @media(max-width:768px){ .hero-stats{display:none;} }
  /* Nothing fits in a very short window */
  @media(min-width:481px) and (max-height:660px){ .hero-stats{display:none;} }

  /* Very narrow phones: no room for the stat tiles above the fold */
  @media(max-width:360px){ .hero-stats{display:none;} }

  /* ── Small tablets (601–768px) ── */
  @media(min-width:601px) and (max-width:768px){
    .section{padding:clamp(64px,10vw,100px) 0;}
    .hero-stats{grid-template-columns:repeat(4,1fr);}
    .reveal-grid{grid-template-columns:repeat(2,1fr);}
    .finished-grid{grid-template-columns:repeat(2,1fr);}
    .trust-grid{grid-template-columns:repeat(2,1fr);}
    .about-grid{grid-template-columns:1fr;}
    .quote-grid{grid-template-columns:1fr;}
    .svc{grid-template-columns:1fr;}
    .svc:nth-child(even) .svc-media{order:0;}
    .foot-grid{grid-template-columns:1fr 1fr;}
    .foot-bottom{padding-bottom:96px;}
    .video-feature{grid-template-columns:1fr;justify-items:center;text-align:center;gap:30px;}
    .vf-copy{max-width:540px;}
  }

  /* ── Tablets & small laptops (769–1080px) ── */
  @media(min-width:769px) and (max-width:1080px){
    .section{padding:clamp(72px,10vw,120px) 0;}
    .reveal-grid{grid-template-columns:repeat(3,1fr);}
    .finished-grid{grid-template-columns:repeat(3,1fr);}
    .trust-grid{grid-template-columns:repeat(2,1fr);}
    .quote-grid{grid-template-columns:1fr 1.1fr;}
    .svc{grid-template-columns:1fr 1fr;}
    .foot-grid{grid-template-columns:1fr 1fr 1fr;}
    .foot-bottom{padding-bottom:0;}
    .video-feature{grid-template-columns:1fr auto;gap:40px;}
  }


  /* Scroll progress bar */
  .scroll-progress{position:fixed;top:0;left:0;height:3px;background:var(--moss);z-index:999;width:0;transition:none;pointer-events:none;}

  /* Card tilt */
  .tilt-card{transition:transform .4s cubic-bezier(.2,.7,.3,1),box-shadow .4s ease;transform-style:preserve-3d;will-change:transform;}
  .tilt-card:hover{box-shadow:var(--shadow-lg);}

  /* Image clip reveal */
  .clip-reveal{clip-path:inset(0 100% 0 0);transition:clip-path .8s cubic-bezier(.2,.7,.3,1);}
  .clip-reveal.in{clip-path:inset(0 0 0 0);}

  /* Magnetic button */
  .btn-magnetic{transition:transform .3s cubic-bezier(.2,.7,.3,1),background .2s,box-shadow .2s;}

  /* Text highlight draw */
  .text-highlight{position:relative;display:inline;background-image:linear-gradient(var(--moss),var(--moss));background-repeat:no-repeat;background-position:0 88%;background-size:0% 3px;transition:background-size .6s cubic-bezier(.2,.7,.3,1);}
  .text-highlight.drawn{background-size:100% 3px;}

  /* Logos / accreditations bar */
  .logos{padding:32px 0;border-bottom:1px solid var(--line);}
  .logos-in{display:flex;flex-direction:column;align-items:center;gap:14px;text-align:center;}
  .logos-lab{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--txt-mut);}
  .logos-row{display:flex;gap:28px 40px;flex-wrap:wrap;justify-content:center;align-items:center;}
  .acc{display:flex;align-items:center;gap:8px;font-family:var(--sans);font-size:14px;font-weight:500;color:var(--txt);opacity:.7;}
  .acc svg{width:16px;height:16px;color:var(--moss);flex-shrink:0;}

  /* Services section */
  .svc-ico{width:64px;height:64px;position:absolute;color:rgba(255,255,255,.45);stroke-width:1;}

  /* Reviews section */
  .reviews-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap;margin-bottom:clamp(36px,5vw,56px);}
  .reviews-head .section-head{margin-bottom:0;}
  .rev-all-link{display:inline-flex;align-items:center;gap:7px;font-size:14px;font-weight:600;color:var(--moss-light);flex-shrink:0;white-space:nowrap;}
  .rev-all-link svg{width:16px;height:16px;}

  /* Process / timeline section */
  @media(max-width:480px){
    .svc-ico{width:48px;height:48px;}
  }

  /* Service areas */
  .area svg{width:16px;height:16px;color:var(--moss);opacity:.6;flex-shrink:0;transition:.2s;}
  .area:hover svg{opacity:1;}
  .areas-note{text-align:center;color:var(--txt-mut);font-size:15px;margin-top:28px;}
  .areas-note a{color:var(--moss);font-weight:600;}

  /* Responsive: services & reviews */
  @media(max-width:768px){
    .reviews-head{flex-direction:column;align-items:flex-start;}
    .video-testimonial{grid-template-columns:1fr;gap:0;}
    .vt-thumb{min-height:220px;}
    .vt-text{padding:22px 20px;}
    .vt-text h3{font-size:20px;}
    .video-feature{grid-template-columns:1fr;}
    .vf-copy{max-width:100%;}
  }
  @media(max-width:480px){
    .areas-grid{grid-template-columns:1fr 1fr;gap:10px;}
  }

  /* Build credit — sits under the legal bar, deliberately quiet */
  .foot-credit{padding:0 0 22px;font-size:12px;line-height:1.5;color:rgba(237,235,227,.45);}
  .foot-credit a{color:rgba(237,235,227,.72);text-decoration:none;border-bottom:1px solid rgba(237,235,227,.25);padding-bottom:1px;}
  @media(hover:hover){ .foot-credit a:hover{color:var(--moss-light);border-bottom-color:var(--moss-light);} }
  .foot-credit a:focus-visible{outline:2px solid var(--moss-light);outline-offset:3px;border-radius:2px;}
  @media(max-width:480px){ .foot-bottom{padding-bottom:14px;} .foot-credit{padding-bottom:100px;} }
  @media(min-width:601px) and (max-width:768px){ .foot-bottom{padding-bottom:14px;} .foot-credit{padding-bottom:96px;} }
  @media(min-width:481px) and (max-width:600px){ .foot-credit{padding-bottom:96px;} }
  /* "More transformations": 5 cards, so centre the bottom two under the top three.
     A 6-column grid lets each card span 2 and the last row start half a card in.
     Guarded with :nth-last-child so it only applies while there are exactly 5. */
  @media(min-width:769px){
    .reveal-grid{grid-template-columns:repeat(6,1fr);}
    .reveal-grid .ritem{grid-column:span 2;}
    .reveal-grid .ritem:nth-child(4):nth-last-child(2){grid-column:2/span 2;}
    .reveal-grid .ritem:nth-child(5):nth-last-child(1){grid-column:4/span 2;}
  }
  /* Two-column band: the odd fifth card gets centred the same way */
  @media(min-width:481px) and (max-width:768px){
    .reveal-grid{grid-template-columns:repeat(4,1fr);}
    .reveal-grid .ritem{grid-column:span 2;}
    .reveal-grid .ritem:nth-child(5):nth-last-child(1){grid-column:2/span 2;}
  }
  /* ── Customer reviews (real, supplied by the client) ── */
  .rev-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:26px;align-items:start;}
  .rev-card{position:relative;background:var(--cream-2);border:1px solid var(--line);border-radius:var(--r-lg);padding:clamp(26px,3vw,38px);box-shadow:var(--shadow-sm);}
  .rev-mark{font-family:var(--serif);font-size:64px;line-height:1;color:var(--moss);opacity:.45;height:34px;display:block;}
  .rev-card p{font-family:var(--serif);font-size:clamp(16px,1.25vw,18px);line-height:1.62;color:var(--txt);}
  .rev-card p + p{margin-top:14px;}
  .rev-by{display:flex;align-items:center;gap:10px;margin-top:22px;padding-top:18px;border-top:1px solid var(--line);}
  .rev-by strong{font-family:var(--sans);font-weight:600;font-size:15px;color:var(--txt);}
  .rev-by span{font-family:var(--sans);font-size:13px;color:var(--txt-mut);}
  .rev-by span::before{content:"·";margin-right:8px;}
  .rev-note{margin-top:26px;font-size:13.5px;color:var(--txt-mut);}
  @media(max-width:768px){
    .rev-grid{grid-template-columns:1fr;gap:18px;}
  }

  /* ── Service & area pages (generated) ── */
  .hero.page-hero{height:auto;min-height:74vh;}
  .page-hero .hero-in{height:auto;min-height:74vh;align-items:center;padding-top:clamp(96px,14vh,140px);padding-bottom:clamp(56px,9vh,96px);}
  .page-hero .hero-ctas{margin-bottom:30px;}
  .crumbs{display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-size:13px;color:rgba(255,255,255,.7);margin-bottom:22px;}
  .crumbs a{color:rgba(255,255,255,.9);border-bottom:1px solid rgba(255,255,255,.3);}
  .crumbs a:hover{color:#fff;border-bottom-color:#fff;}
  .has-ivy > .wrap{position:relative;z-index:1;}
  .has-ivy .about-text{background:rgba(28,29,24,.55);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);padding:clamp(22px,3vw,36px);border-radius:var(--r-lg);}
  .page-intro{display:grid;grid-template-columns:1.2fr .8fr;gap:clamp(30px,5vw,64px);align-items:start;}
  .page-intro .about-text{max-width:none;}
  .about-text h3{font-size:clamp(20px,2.4vw,24px);margin:30px 0 10px;}
  .about-text a,.faq-a a,.areas-note a{color:var(--moss);font-weight:600;border-bottom:1px solid currentColor;}
  .incl-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);padding:clamp(24px,3vw,34px);box-shadow:var(--shadow);position:sticky;top:100px;}
  .incl-card h3{font-size:22px;margin-bottom:18px;}
  .incl-card .svc-incl{grid-template-columns:1fr;gap:12px;margin-bottom:26px;}
  .incl-card .svc-incl li{font-size:15px;}
  .incl-card .svc-incl a{border-bottom:1px solid var(--line-strong);}
  .incl-card .svc-incl a:hover{color:var(--moss);border-bottom-color:var(--moss);}
  .incl-card .btn{width:100%;justify-content:center;}
  .proj-copy{color:var(--txt-mut);font-size:15.5px;line-height:1.6;margin:0 0 18px;}
  .ba-feature > .fcard{aspect-ratio:3/4;}
  .proj-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:auto;}
  .ba-info .proj-actions .btn{margin-top:0;align-self:auto;}
  .rev-grid.single{grid-template-columns:1fr;max-width:760px;}
  .process-sec .timeline{max-width:760px;}
  .tl-dot{font-family:var(--serif);font-weight:600;}
  .links-sec{padding:clamp(56px,8vw,100px) 0;}
  .links-h{font-size:clamp(20px,2.4vw,24px);margin:0 0 16px;}
  .links-h:not(:first-of-type){margin-top:40px;}
  .areas-note{text-align:left;}
  .cta-band .section-head{margin-bottom:28px;}
  .cta-band .hero-ctas{justify-content:center;margin-bottom:0;}
  @media(max-width:900px){.page-intro{grid-template-columns:1fr;}.incl-card{position:static;}}
  @media(max-width:480px){
    .page-hero .hero-in{min-height:0;padding-top:72px;padding-bottom:56px;}
    .crumbs{font-size:12px;margin-bottom:16px;}
    .ba-feature > .fcard{aspect-ratio:4/5;}
    .proj-actions .btn{width:100%;justify-content:center;min-height:50px;}
    .cta-band .hero-ctas .btn{width:100%;}
  }
</style>
{% include "head-extra.njk" %}
</head>
<body>
{% set navPrefix = "index.html" %}{% include "header.njk" %}

<main id="main">

<section class="hero page-hero" id="hero">
  <div class="hero-bg" aria-hidden="true">
    <img src="/assets/img/garden-room-patio-turf-after.jpg" fetchpriority="high" alt="Finished garden with a porcelain patio, garden room and striped lawn" loading="eager" width="1600" height="900">
    <div class="hero-overlay"></div>
  </div>
  <div class="wrap hero-in">
    <div class="hero-content">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="index.html">Home</a><span aria-hidden="true">/</span><span aria-current="page">Garden design &amp; build</span></nav>
      <h1><span class="hero-kicker">Garden design &amp; build in Ferndown &amp; Dorset</span> One team, from idea<br>to finished garden.</h1>
      <p class="hero-sub">Garden design and build for homes across Ferndown, Bournemouth, Poole and East Dorset — planned around how you use your garden, and built by the same team that designed it.</p>
      <div class="hero-ctas">
        <a href="index.html#quote" class="btn btn-primary btn-lg">Get my free quote <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 18l6-6"/><path d="M13 6l6 6"/></svg></a>
        <a href="tel:{{ gm.contact.phoneLink | h }}" class="btn btn-ghost btn-lg hero-ghost"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5l-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2"/></svg> {{ gm.contact.phone | h }}</a>
      </div>
      <div class="hero-trust">
        <div class="ht-badges">
          <span><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2l4-4"/><path d="M12 3a12 12 0 008.5 3A12 12 0 0112 21 12 12 0 013.5 6 12 12 0 0112 3"/></svg> Fully insured</span>
          <span><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="6"/><path d="M12 15l3.4 5.89 1.6-3.23h3L17 14"/><path d="M6.8 12l-3 .01L5.2 15.23 8.6 20.89 12 15"/></svg> 12-month guarantee</span>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section sec-alt has-ivy" id="about">
  <img class="ivy-drape" src="/assets/img/ivy-drape.png" loading="lazy" decoding="async" alt="" aria-hidden="true" width="1584" height="672">
  <div class="wrap page-intro">
    <div class="about-text reveal d1">
      <span class="eyebrow">Garden design &amp; build</span>
      <h2>Designed around <span class="text-highlight">how you live.</span></h2>
        <p>A good garden design starts with questions, not drawings. Where does the sun fall in the evening? Where do the kids play? Do you want to grow your own, entertain, or just sit and enjoy it? How much time do you want to spend looking after it?</p>
        <p>From there we plan the whole space — patios and paths, lawns, raised sleeper beds, borders and planting — so everything works together. Because we build what we design, the plan is always grounded in what's practical on your site and within your budget.</p>
        <p>The landscaping itself is done by our own team. For specialist work such as electrics and plumbing we bring in trusted trades we've worked with for years, and we manage the whole project from start to finish.</p>
    </div>
    <aside class="incl-card reveal d2">
      <h3>What we bring together</h3>
      <ul class="svc-incl"><li><i aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg></i><span><a href="patios.html">Patios</a> and paths</span></li><li><i aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg></i><span>Lawns — natural turf or <a href="artificial-grass.html">artificial grass</a></span></li><li><i aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg></i><span>Raised sleeper beds and borders</span></li><li><i aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg></i><span>Planting and hedging</span></li><li><i aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg></i><span>Gravel areas and edging</span></li><li><i aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg></i><span>Drainage and levelling</span></li></ul>
      <a href="index.html#quote" class="btn btn-primary">Get my free quote <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 18l6-6"/><path d="M13 6l6 6"/></svg></a>
    </aside>
  </div>
</section>

<section class="section process-sec" id="process">
  <div class="wrap">
    <div class="section-head reveal"><span class="eyebrow">How it works</span><h2>From first visit to <span class="text-highlight">finished garden.</span></h2></div>
    <div class="timeline">
        <div class="tl-item reveal"><div class="tl-rail"><div class="tl-dot" aria-hidden="true">1</div><div class="tl-conn"></div></div>
          <div class="tl-body"><span class="tl-num">STEP 01</span><h3>Free site visit</h3><p>We visit, look at the space, measure up and talk through what you want from your garden. No charge and no pressure.</p></div></div>
        <div class="tl-item reveal"><div class="tl-rail"><div class="tl-dot" aria-hidden="true">2</div><div class="tl-conn"></div></div>
          <div class="tl-body"><span class="tl-num">STEP 02</span><h3>Design &amp; fixed quote</h3><p>We plan the layout and materials, then send a clear, fixed written price with a realistic timeline — within a week.</p></div></div>
        <div class="tl-item reveal"><div class="tl-rail"><div class="tl-dot" aria-hidden="true">3</div><div class="tl-conn"></div></div>
          <div class="tl-body"><span class="tl-num">STEP 03</span><h3>Build</h3><p>Our own team builds it, and all waste is removed and disposed of legally — we're a registered waste carrier.</p></div></div>
        <div class="tl-item reveal"><div class="tl-rail"><div class="tl-dot" aria-hidden="true">4</div><div class="tl-conn"></div></div>
          <div class="tl-body"><span class="tl-num">STEP 04</span><h3>Handover &amp; guarantee</h3><p>We walk you round the finished garden. All hard landscaping carries a 12-month workmanship guarantee.</p></div></div>
    </div>
  </div>
</section>

<section class="section sec-alt" id="work">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Recent work</span>
      <h2>Gardens we've designed and built.</h2>
      <p>Drag a slider to compare before and after, or open a project to see every photo.</p>
    </div>
    <article class="ba-feature reveal">
      <div class="ba-slider">
        <img class="ba-img ba-before" src="/assets/img/garden-room-patio-turf-after.jpg" loading="lazy" decoding="async" alt="After: mottled grey porcelain patio around a garden room with a new striped lawn">
        <img class="ba-img ba-after" src="/assets/img/garden-room-patio-turf-before.jpg" loading="lazy" decoding="async" alt="Before: bare ground around a new garden room before landscaping">
        <span class="ba-tag ba-tag-b">Before</span>
        <span class="ba-tag ba-tag-a">After</span>
        <div class="ba-line"></div>
        <div class="ba-handle"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6l-5 6l5 6"/><path d="M16 6l5 6l-5 6"/></svg></div>
      </div>
      <div class="ba-info">
        <h3>Garden room patio, path &amp; lawn</h3>
        <span class="ba-loc"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.5-7-11a7 7 0 0114 0c0 4.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg> Dorset</span>
        <p class="proj-copy">Bare, churned-up ground around a brand-new garden room, turned into a finished garden. We laid mottled grey porcelain with aged slabs, framed it with rustic charcoal edging stones and graffito grouting, ran a porcelain path down the side of the garden room, built a raised sleeper border painted in Cuprinol Shades anthracite and planted with Griselinia hedging, then laid a new lawn.</p>
        <ul class="ba-meta"><li><span>Project</span><strong>Patio, path, sleeper border &amp; turf</strong></li><li><span>Materials</span><strong>Mottled grey porcelain, charcoal edging</strong></li></ul>
        <div class="proj-actions"><button type="button" class="btn btn-ghost" data-lb="0"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 7h1a2 2 0 002-2 1 1 0 011-1h6a1 1 0 011 1 2 2 0 002 2h1a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9a2 2 0 012-2"/><circle cx="12" cy="13" r="3"/></svg> See all 4 photos</button><a href="index.html#quote" class="btn btn-dark">Get my free quote <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 18l6-6"/><path d="M13 6l6 6"/></svg></a></div>
      </div>
    </article>
    <article class="ba-feature reveal">
      <div class="fcard" data-idx="1" tabindex="0" role="button" aria-label="Sleeper veggie patch &amp; amphitheatre — view 4 photos">
        <img loading="lazy" decoding="async" src="/assets/img/projects/sleeper-veggie-patch/4.jpg" alt="Curved raised sleeper veggie beds and amphitheatre-style seating with gravel paths and a pergola arch">
        <span class="fcard-count"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l9 5-9 5-9-5 9-5"/><path d="M3 13l9 5 9-5"/></svg>4 photos</span>
        <span class="fcard-dots" aria-hidden="true"><i class="on"></i><i class=""></i><i class=""></i><i class=""></i></span>
        <div class="fcard-ov">Sleeper veggie patch &amp; amphitheatre</div>
      </div>
      <div class="ba-info">
        <h3>Sleeper veggie patch &amp; amphitheatre</h3>
        <span class="ba-loc"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.5-7-11a7 7 0 0114 0c0 4.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg> Dorset</span>
        <p class="proj-copy">Raised timber sleeper beds built into a veggie patch, with curved, stepped sleeper walls forming amphitheatre-style seating. Gravel paths wind between the beds and a timber pergola arch marks the way in.</p>
        <ul class="ba-meta"><li><span>Project</span><strong>Raised beds, seating &amp; paths</strong></li><li><span>Materials</span><strong>Timber sleepers, gravel, pergola arch</strong></li></ul>
        <div class="proj-actions"><a href="index.html#quote" class="btn btn-dark">Get my free quote <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 18l6-6"/><path d="M13 6l6 6"/></svg></a></div>
      </div>
    </article>
    <article class="ba-feature reveal">
      <div class="ba-slider">
        <img class="ba-img ba-before" src="/assets/img/garden-levelling-turf-after.jpg" loading="lazy" decoding="async" alt="After: cleared and levelled garden finished with a new striped lawn">
        <img class="ba-img ba-after" src="/assets/img/garden-levelling-turf-before.jpg" loading="lazy" decoding="async" alt="Before: overgrown garden being cleared with a mini digger">
        <span class="ba-tag ba-tag-b">Before</span>
        <span class="ba-tag ba-tag-a">After</span>
        <div class="ba-line"></div>
        <div class="ba-handle"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6l-5 6l5 6"/><path d="M16 6l5 6l-5 6"/></svg></div>
      </div>
      <div class="ba-info">
        <h3>Overgrown garden cleared, levelled &amp; turfed</h3>
        <span class="ba-loc"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.5-7-11a7 7 0 0114 0c0 4.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg> Dorset</span>
        <p class="proj-copy">A garden taken over by weeds and brambles, cleared with a mini digger, levelled and finished with fresh natural turf for a clean, open lawn.</p>
        <ul class="ba-meta"><li><span>Project</span><strong>Clearance, levelling &amp; turf</strong></li><li><span>Materials</span><strong>Natural turf</strong></li></ul>
        <div class="proj-actions"><button type="button" class="btn btn-ghost" data-lb="2"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 7h1a2 2 0 002-2 1 1 0 011-1h6a1 1 0 011 1 2 2 0 002 2h1a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9a2 2 0 012-2"/><circle cx="12" cy="13" r="3"/></svg> See all 3 photos</button><a href="index.html#quote" class="btn btn-dark">Get my free quote <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 18l6-6"/><path d="M13 6l6 6"/></svg></a></div>
      </div>
    </article>
    <article class="ba-feature reveal">
      <div class="fcard" data-idx="3" tabindex="0" role="button" aria-label="Enclosed garden &amp; supporting wall — view 2 photos">
        <img loading="lazy" decoding="async" src="/assets/img/projects/supporting-wall/1.jpg" alt="Small enclosed garden with Carbon Indian Sandstone patio, artificial grass and a new supporting wall">
        <span class="fcard-count"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l9 5-9 5-9-5 9-5"/><path d="M3 13l9 5 9-5"/></svg>2 photos</span>
        <span class="fcard-dots" aria-hidden="true"><i class="on"></i><i class=""></i></span>
        <div class="fcard-ov">Enclosed garden &amp; supporting wall</div>
      </div>
      <div class="ba-info">
        <h3>Enclosed garden &amp; supporting wall</h3>
        <span class="ba-loc"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.5-7-11a7 7 0 0114 0c0 4.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg> Dorset</span>
        <p class="proj-copy">A small enclosed garden rebuilt from the ground up. We built a new supporting wall along the back, laid Carbon Indian Sandstone paving, and added a panel of artificial grass over underground drainage so the whole space stays usable all year.</p>
        <ul class="ba-meta"><li><span>Project</span><strong>Wall, patio, artificial grass &amp; drainage</strong></li><li><span>Materials</span><strong>Carbon Indian Sandstone, artificial grass</strong></li></ul>
        <div class="proj-actions"><a href="index.html#quote" class="btn btn-dark">Get my free quote <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 18l6-6"/><path d="M13 6l6 6"/></svg></a></div>
      </div>
    </article>
  </div>
</section>

<section class="section" id="reviews">
  <div class="wrap">
    <div class="section-head reveal"><span class="eyebrow">In their words</span><h2>What our customers say.</h2></div>
    <div class="rev-grid single">
      <figure class="rev-card reveal">
        <span class="rev-mark" aria-hidden="true">&ldquo;</span>
        <blockquote>
          <p>GM Garden Landscapes have worked for me for almost 10 years providing maintenance and landscaping services on a weekly basis.</p>
          <p>Gary the owner is an easy-going person who you can quickly get along with. His enthusiasm and helpfulness stand out and his team&rsquo;s ability to get jobs done is excellent. Very good communication skills and always tries to accommodate clients wishes with professional suggestions. Totally trustworthy and do not have any hesitation in recommending the team for almost any garden work including irrigation systems.</p>
          <p>You will not be disappointed.</p>
        </blockquote>
        <figcaption class="rev-by"><strong>Geoff R</strong><span>West Parley</span></figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="section" id="faq">
  <div class="wrap faq-wrap">
    <div class="section-head reveal">
      <span class="eyebrow">FAQ</span>
      <h2>Garden design questions, answered.</h2>
      <p>Can't see your question? Call us on {{ gm.contact.phone | h }} — happy to help, no hard sell.</p>
    </div>
    <div class="faq-list reveal">
      <div class="faq-item"><button class="faq-q" aria-expanded="false"><span>Do I need a detailed design before you start?</span><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14m-7-7h14"/></svg></button><div class="faq-a" role="region"><p>No. Some customers come to us with a clear plan; others just know they want the garden to work better. Either way, we'll talk it through on site and put forward a layout and materials that suit how you want to use the space.</p></div></div>
      <div class="faq-item"><button class="faq-q" aria-expanded="false"><span>Can you keep parts of my existing garden?</span><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14m-7-7h14"/></svg></button><div class="faq-a" role="region"><p>Yes. Plenty of projects keep what's already working — a mature tree, a good hedge, an established lawn — and rework the rest around it.</p></div></div>
      <div class="faq-item"><button class="faq-q" aria-expanded="false"><span>Is planting guaranteed?</span><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14m-7-7h14"/></svg></button><div class="faq-a" role="region"><p>Our 12-month workmanship guarantee covers all hard landscaping. Planting isn't covered, because how well plants establish depends on aftercare, weather and soil conditions we can't control — but we'll give you clear advice on looking after it.</p></div></div>
      <div class="faq-item"><button class="faq-q" aria-expanded="false"><span>How much does a garden design and build cost?</span><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14m-7-7h14"/></svg></button><div class="faq-a" role="region"><p>Every garden is different, so we price each project properly. What moves the price is the size of the space, the materials you choose, how much groundwork is needed and access. We visit, measure up and give you a fixed written quote — free, with no obligation.</p></div></div>
      <div class="faq-item"><button class="faq-q" aria-expanded="false"><span>Do you use subcontractors?</span><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14m-7-7h14"/></svg></button><div class="faq-a" role="region"><p>The landscaping itself is done by our own team. For specialist work such as electrics and plumbing we bring in trusted trades we have worked with for years — but we manage the project from start to finish and stay accountable for it.</p></div></div>
    </div>
  </div>
</section>

<section class="section links-sec" id="more">
  <div class="wrap">
    <h3 class="links-h reveal">Other services</h3>
    <div class="areas-grid reveal"><a class="area" href="patios.html">Patios &amp; paving <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6l-6 6"/></svg></a><a class="area" href="driveways.html">Driveways <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6l-6 6"/></svg></a><a class="area" href="fencing.html">Fencing &amp; gates <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6l-6 6"/></svg></a><a class="area" href="artificial-grass.html">Artificial grass <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6l-6 6"/></svg></a></div>
    <h3 class="links-h reveal">Areas we cover</h3>
