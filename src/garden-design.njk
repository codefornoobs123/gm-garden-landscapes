<script>
const $=(s,c=document)=>c.querySelector(s);
const $$=(s,c=document)=>[...c.querySelectorAll(s)];
// Project photo sets for the lightbox (generated)
const finished=[{"t": "Garden room patio, path & lawn", "cap": "Bare, churned-up ground around a brand-new garden room, turned into a finished garden. We laid mottled grey porcelain with aged slabs, framed it with rustic charcoal edging stones and graffito grouting, ran a porcelain path down the side of the garden room, built a raised sleeper border painted in Cuprinol Shades anthracite and planted with Griselinia hedging, then laid a new lawn.", "imgs": ["/assets/img/projects/mottled-porcelain/2.jpg", "/assets/img/projects/mottled-porcelain/1.jpg", "/assets/img/projects/mottled-porcelain/3.jpg", "/assets/img/projects/mottled-porcelain/4.jpg"]}, {"t": "Sleeper veggie patch & amphitheatre", "cap": "Raised timber sleeper beds built into a veggie patch, with curved, stepped sleeper walls forming amphitheatre-style seating. Gravel paths wind between the beds and a timber pergola arch marks the way in.", "imgs": ["/assets/img/projects/sleeper-veggie-patch/4.jpg", "/assets/img/projects/sleeper-veggie-patch/1.jpg", "/assets/img/projects/sleeper-veggie-patch/2.jpg", "/assets/img/projects/sleeper-veggie-patch/3.jpg"]}, {"t": "Overgrown garden cleared, levelled & turfed", "cap": "A garden taken over by weeds and brambles, cleared with a mini digger, levelled and finished with fresh natural turf for a clean, open lawn.", "imgs": ["/assets/img/projects/turfing/1.jpg", "/assets/img/projects/turfing/2.jpg", "/assets/img/projects/turfing/3.jpg"]}, {"t": "Enclosed garden & supporting wall", "cap": "A small enclosed garden rebuilt from the ground up. We built a new supporting wall along the back, laid Carbon Indian Sandstone paving, and added a panel of artificial grass over underground drainage so the whole space stays usable all year.", "imgs": ["/assets/img/projects/supporting-wall/1.jpg", "/assets/img/projects/supporting-wall/2.jpg"]}];
const finishedGrid=$('#work');
// Cycle a card's photos while hovering (pointer devices only, and never when motion is reduced)
if(window.matchMedia('(hover:hover)').matches && !window.matchMedia('(prefers-reduced-motion:reduce)').matches){
  $$('.fcard').forEach(card=>{
    const p=finished[+card.dataset.idx]; if(p.imgs.length<2) return;
    const img=card.querySelector('img'), dots=[...card.querySelectorAll('.fcard-dots i')];
    let timer=null, k=0, primed=false;
    const paint=()=>{img.src=p.imgs[k];dots.forEach((d,j)=>d.classList.toggle('on',j===k));};
    card.addEventListener('mouseenter',()=>{
      if(!primed){p.imgs.slice(1).forEach(src=>{const im=new Image();im.src=src;});primed=true;}
      clearInterval(timer);
      timer=setInterval(()=>{k=(k+1)%p.imgs.length;paint();},1100);
    });
    card.addEventListener('mouseleave',()=>{clearInterval(timer);timer=null;k=0;paint();});
  });
}

// === Lightbox (browse each project's photos) ===
const lb=$('#lightbox'),lbCap=$('#lbCap'),lbTrack=$('#lbTrack');
const lbImg=$('#lbImg'),lbPrevImg=$('#lbPrevImg'),lbNextImg=$('#lbNextImg'),lbView=$('.lb-view');
let lbP=0,lbI=0,lbBusy=false,lbQueued=0;
const lbPreloaded=new Set();
function preloadProject(i){
  finished[i].imgs.forEach(src=>{ if(!lbPreloaded.has(src)){ lbPreloaded.add(src); const im=new Image(); im.src=src; } });
}
const lbCount=()=>finished[lbP].imgs.length;
const lbWrap=i=>{const n=lbCount();return (i%n+n)%n;};
function lbStep(){
  const g=parseFloat(getComputedStyle(lbView).getPropertyValue('--lb-gap'))||0;
  return lbView.clientWidth+g;
}
function lbSetTrack(px,animate){
  lbTrack.style.transition = animate ? 'transform .32s cubic-bezier(.22,.61,.36,1)' : 'none';
  lbTrack.style.transform  = 'translateX('+(-lbStep()+px)+'px)';
}
function lbPaint(){
  const p=finished[lbP], n=lbCount();
  lbImg.src=p.imgs[lbI];
  lbImg.alt=`${p.t}${p.loc?' in '+p.loc:''} — photo ${lbI+1}`;
  if(n>1){
    lbPrevImg.src=p.imgs[lbWrap(lbI-1)];
    lbNextImg.src=p.imgs[lbWrap(lbI+1)];
    lbPrevImg.style.visibility=lbNextImg.style.visibility='';
  }else{
    lbPrevImg.removeAttribute('src'); lbNextImg.removeAttribute('src');
    lbPrevImg.style.visibility=lbNextImg.style.visibility='hidden';
  }
  lbCap.innerHTML=`${p.t}${p.loc?' · '+p.loc:''} · ${lbI+1}/${n}<span class="lb-detail"></span>`;
  lbCap.querySelector('.lb-detail').textContent=p.cap||'';
}
// slide the track a whole panel, then silently re-centre on the new photo
function lbGo(dir){
  if(lbCount()<2) return;
  if(lbBusy){ lbQueued=Math.max(-3,Math.min(3,lbQueued+dir)); return; }  // stack fast taps, capped
  lbBusy=true;
  lbSetTrack(-dir*lbStep(),true);
  let settled=false;
  const settle=()=>{
    if(settled) return; settled=true;
    lbTrack.removeEventListener('transitionend',settle);
    lbI=lbWrap(lbI+dir);
    lbPaint();
    lbSetTrack(0,false);
    void lbTrack.offsetWidth;          // flush, so the next move animates
    lbBusy=false;
    if(lbQueued){ const d=lbQueued>0?1:-1; lbQueued-=d; lbGo(d); }
  };
  lbTrack.addEventListener('transitionend',settle);
  setTimeout(settle,420);              // fallback if transitionend never fires
}
let lbOpener=null;
function openLb(i,opener){
  lbOpener = opener || null;
  lbP=i; lbI=0; preloadProject(i);
  lb.classList.add('open'); lb.setAttribute('aria-hidden','false');
  document.body.style.overflow='hidden';
  lbPaint(); lbSetTrack(0,false);
}
finishedGrid.addEventListener('click',e=>{const c=e.target.closest('.fcard');if(c)openLb(+c.dataset.idx,c);});
finishedGrid.addEventListener('keydown',e=>{
  if(e.key!=='Enter'&&e.key!==' '&&e.key!=='Spacebar') return;
  const c=e.target.closest('.fcard'); if(!c) return;
  e.preventDefault(); openLb(+c.dataset.idx,c);
});
$('#lbClose').onclick=()=>{
  lb.classList.remove('open'); lb.setAttribute('aria-hidden','true'); document.body.style.overflow='';
  if(lbOpener){ lbOpener.focus(); lbOpener=null; }
};
$('#lbNext').onclick=()=>lbGo(1);
$('#lbPrev').onclick=()=>lbGo(-1);
lb.addEventListener('click',e=>{if(e.target===lb)$('#lbClose').click();});
window.addEventListener('resize',()=>{if(lb.classList.contains('open')&&!lbBusy)lbSetTrack(0,false);});
document.addEventListener('keydown',e=>{if(!lb.classList.contains('open'))return;if(e.key==='Escape')$('#lbClose').click();if(e.key==='ArrowRight')lbGo(1);if(e.key==='ArrowLeft')lbGo(-1);});

// Drag the track with your finger — the neighbouring photo comes in as you go
(function(){
  const view=lbView; if(!view) return;
  let x0=0,y0=0,dx=0,dragging=false,decided=false,horizontal=false;
  view.addEventListener('touchstart',e=>{
    if(e.touches.length!==1||lbBusy||lbCount()<2) return;
    x0=e.touches[0].clientX; y0=e.touches[0].clientY;
    dx=0; dragging=true; decided=false; horizontal=false;
    lbTrack.style.transition='none';
  },{passive:true});
  view.addEventListener('touchmove',e=>{
    if(!dragging||e.touches.length!==1) return;
    const cx=e.touches[0].clientX, cy=e.touches[0].clientY;
    const ax=Math.abs(cx-x0), ay=Math.abs(cy-y0);
    if(!decided && (ax>8||ay>8)){ decided=true; horizontal=ax>ay; }
    if(!horizontal) return;
    dx=cx-x0;
    if(e.cancelable) e.preventDefault();
    lbSetTrack(dx,false);
  },{passive:false});
  const finish=()=>{
    if(!dragging) return;
    dragging=false;
    const thresh=Math.min(70,lbView.clientWidth*0.18);
    if(horizontal && Math.abs(dx)>thresh) lbGo(dx<0?1:-1);
    else lbSetTrack(0,true);
    dx=0;
  };
  view.addEventListener('touchend',finish,{passive:true});
  view.addEventListener('touchcancel',finish,{passive:true});
})();
$$('[data-lb]').forEach(b=>b.addEventListener('click',()=>openLb(+b.dataset.lb,b)));
// FAQ accordion
$$('.faq-item').forEach(el=>{
  const btn=el.querySelector('.faq-q'),ans=el.querySelector('.faq-a');
  btn.onclick=()=>{
    const open=el.classList.contains('open');
    $$('.faq-item').forEach(f=>{f.classList.remove('open');f.querySelector('.faq-a').style.maxHeight=null;f.querySelector('.faq-q').setAttribute('aria-expanded','false');});
    if(!open){el.classList.add('open');ans.style.maxHeight=ans.scrollHeight+'px';btn.setAttribute('aria-expanded','true');}
  };
});
const burger=$('#burger'),mm=$('#mobileMenu');
function closeMenu(){burger.classList.remove('open');mm.classList.remove('open');burger.setAttribute('aria-expanded','false');mm.setAttribute('aria-hidden','true');document.body.style.overflow='';}
burger.onclick=()=>{const open=burger.classList.toggle('open');mm.classList.toggle('open',open);burger.setAttribute('aria-expanded',String(open));mm.setAttribute('aria-hidden',String(!open));document.body.style.overflow=open?'hidden':'';if(open){const first=mm.querySelector('a');if(first)first.focus();}};
$$('#mobileMenu a').forEach(a=>a.addEventListener('click',closeMenu));
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&mm.classList.contains('open'))closeMenu();});

const nav=$('#nav');
const onScroll=()=>nav.classList.toggle('scrolled',window.scrollY>40);
onScroll();window.addEventListener('scroll',onScroll,{passive:true});

const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}}),{threshold:0.12,rootMargin:'0px 0px -40px 0px'});
$$('.reveal').forEach(el=>io.observe(el));
const tlio=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)e.target.classList.add('in');}),{threshold:0.4});
$$('.tl-item').forEach(el=>tlio.observe(el));

const fmtCount=(v,dec)=>v.toLocaleString("en-GB",{minimumFractionDigits:dec,maximumFractionDigits:dec});
function animCount(el){
  const target=+el.dataset.count,dec=+el.dataset.dec||0,dur=1600,t0=performance.now();
  if(el._raf) cancelAnimationFrame(el._raf);
  function tick(t){const p=Math.min((t-t0)/dur,1);const e=1-Math.pow(1-p,3);el.textContent=fmtCount(target*e,dec);if(p<1){el._raf=requestAnimationFrame(tick);}else{el.textContent=fmtCount(target,dec);el._raf=null;}}
  el._raf=requestAnimationFrame(tick);
}
const cio=new IntersectionObserver(es=>es.forEach(e=>{
  const el=e.target,dec=+el.dataset.dec||0;
  if(e.isIntersecting){animCount(el);} else {if(el._raf)cancelAnimationFrame(el._raf);el._raf=null;el.textContent=fmtCount(0,dec);}
}),{threshold:0.5});
// Real numbers sit in the HTML for crawlers and no-JS visitors; zero them just before the count-up
if(!matchMedia('(prefers-reduced-motion:reduce)').matches){
  $$('[data-count]').forEach(el=>{el.textContent=fmtCount(0,+el.dataset.dec||0);cio.observe(el);});
}

let baActive=null;
function initBA(c){
  const after=c.querySelector('.ba-after'),line=c.querySelector('.ba-line'),h=c.querySelector('.ba-handle');
  const tagB=c.querySelector('.ba-tag-b'),tagA=c.querySelector('.ba-tag-a');
  const set=p=>{
    p=Math.max(3,Math.min(97,p));
    after.style.clipPath=`inset(0 ${100-p}% 0 0)`;line.style.left=p+'%';h.style.left=p+'%';
    // Slid hard to one side: the label for the image you can no longer see steps out of the way
    if(tagA) tagA.classList.toggle('is-hidden',p>=92);
    if(tagB) tagB.classList.toggle('is-hidden',p<=8);
  };
  const pct=e=>{const r=c.getBoundingClientRect();const x=(e.touches?e.touches[0].clientX:e.clientX)-r.left;return x/r.width*100;};
  c.addEventListener('mousedown',e=>{baActive=c;set(pct(e));});
  c.addEventListener('touchstart',e=>{baActive=c;set(pct(e));},{passive:true});
  c.addEventListener('touchmove',e=>{if(baActive===c){set(pct(e));}},{passive:true});
  set(50);c._set=set;
}
window.addEventListener('mousemove',e=>{if(baActive)baActive._set((()=>{const r=baActive.getBoundingClientRect();return (e.clientX-r.left)/r.width*100;})());});
window.addEventListener('mouseup',()=>baActive=null);
window.addEventListener('touchend',()=>baActive=null);
$$('.ba-slider').forEach(initBA);

$$('.btn-primary,.btn-dark').forEach(b=>b.addEventListener('click',function(e){
  const r=document.createElement('span');r.className='ripple';const rect=this.getBoundingClientRect();const s=Math.max(rect.width,rect.height);
  r.style.width=r.style.height=s+'px';r.style.left=(e.clientX-rect.left-s/2)+'px';r.style.top=(e.clientY-rect.top-s/2)+'px';
  this.appendChild(r);setTimeout(()=>r.remove(),600);
}));


// === Scroll progress bar ===
(function(){
  var bar=document.getElementById('scrollProgress');
  if(!bar)return;
  function update(){var h=document.documentElement,s=document.body;var st=h.scrollTop||s.scrollTop;var sh=(h.scrollHeight||s.scrollHeight)-h.clientHeight;bar.style.width=(sh>0?(st/sh*100):0)+'%';}
  window.addEventListener('scroll',update,{passive:true});
  update();
})();

// === Text highlight draw-in ===
(function(){
  var els=document.querySelectorAll('.text-highlight');
  if(!els.length)return;
  var o=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('drawn');o.unobserve(e.target);}});},{threshold:0.6});
  els.forEach(function(el){o.observe(el);});
})();
</script>
<script>var _y=document.getElementById("yr");if(_y)_y.textContent=new Date().getFullYear();</script>
<script>
(function(){
  var selectors=['#about','#work','#cta'];
  var reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
  var hasHover=matchMedia('(hover: hover) and (pointer: fine)').matches;
  var dpr=Math.min(window.devicePixelRatio||1,2);
  function spr(c,soft){var s=document.createElement('canvas');s.width=s.height=64;var g=s.getContext('2d'),rg=g.createRadialGradient(32,32,0,32,32,32);rg.addColorStop(0,c);rg.addColorStop(soft?.5:.3,c.replace('1)',soft?'.32)':'.55)'));rg.addColorStop(1,c.replace('1)','0)'));g.fillStyle=rg;g.beginPath();g.arc(32,32,32,0,7);g.fill();return s;}
  var sHaze=spr('rgba(196,205,178,1)',true),sCream=spr('rgba(247,242,228,1)',false),sGold=spr('rgba(226,196,132,1)',false),sWhite=spr('rgba(255,253,246,1)',false);
  var instances=[];
  selectors.forEach(function(sel){
    var el=document.querySelector(sel);
    if(!el)return;
    var cv=document.createElement('canvas');
    cv.setAttribute('aria-hidden','true');
    cv.style.cssText='position:absolute;inset:0;width:100%;height:100%;z-index:0;pointer-events:none';
    if(getComputedStyle(el).position==='static')el.style.position='relative';
    el.insertBefore(cv,el.firstChild);
    var ctx=cv.getContext('2d');
    var inst={el:el,cv:cv,ctx:ctx,W:0,H:0,mx:null,my:null,parts:[]};
    function mk(){var d=Math.random()*Math.random();d=.05+d*.95;var sp=d<.34?sHaze:(d<.7?sCream:(Math.random()<.5?sGold:sWhite));return{d:d,hx:Math.random()*inst.W,y:Math.random()*inst.H,vy:3+d*15,amp:3+d*11,freq:.14+Math.random()*.32,ph:Math.random()*7,a:(.14+d*.58)*(.8+Math.random()*.4),sz:8+d*32,spr:sp};}
    inst.resize=function(){inst.W=el.clientWidth;inst.H=el.clientHeight;cv.width=inst.W*dpr;cv.height=inst.H*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);var n=Math.max(24,Math.min(48,Math.round(inst.W*inst.H/18000)));inst.parts=[];for(var i=0;i<n;i++)inst.parts.push(mk());inst.parts.sort(function(a,b){return a.d-b.d;});};
    inst.resize();
    if(hasHover){el.addEventListener('pointermove',function(e){var r=cv.getBoundingClientRect();inst.mx=e.clientX-r.left;inst.my=e.clientY-r.top;});el.addEventListener('pointerleave',function(){inst.mx=inst.my=null;});}
    instances.push(inst);
  });
  var raf=null,last=0;
  function drawInst(inst,t,dt){var c=inst.ctx,W=inst.W,H=inst.H,mx=inst.mx,my=inst.my;c.clearRect(0,0,W,H);c.globalCompositeOperation='lighter';for(var i=0;i<inst.parts.length;i++){var p=inst.parts[i];p.y-=p.vy*dt;if(p.y<-34){p.y=H+34;p.hx=Math.random()*W;}var bx=p.hx+Math.sin(t/1000*p.freq+p.ph)*p.amp,px=bx,py=p.y;if(mx!==null){var dx=mx-bx,dy=my-p.y,f=1/(1+(dx*dx+dy*dy)/25600),lf=.03+p.d*.16,cx=3+p.d*20,cy=2+p.d*15;px=bx+Math.max(-cx,Math.min(cx,dx*lf*f));py=p.y+Math.max(-cy,Math.min(cy,dy*lf*.75*f));}c.globalAlpha=p.a;c.drawImage(p.spr,px-p.sz/2,py-p.sz/2,p.sz,p.sz);}c.globalAlpha=1;c.globalCompositeOperation='source-over';}
  function frame(t){var dt=Math.min((t-last)/1000||0,.05);last=t;instances.forEach(function(inst){drawInst(inst,t,dt);});raf=requestAnimationFrame(frame);}
  function start(){if(raf)cancelAnimationFrame(raf);last=0;raf=requestAnimationFrame(frame);}
  function stop(){if(raf)cancelAnimationFrame(raf);raf=null;}
  function drawStatic(){instances.forEach(function(inst){var c=inst.ctx,W=inst.W,H=inst.H;c.clearRect(0,0,W,H);c.globalCompositeOperation='lighter';inst.parts.forEach(function(p){c.globalAlpha=p.a;c.drawImage(p.spr,p.hx-p.sz/2,p.y-p.sz/2,p.sz,p.sz);});c.globalAlpha=1;c.globalCompositeOperation='source-over';});}
  var rt;window.addEventListener('resize',function(){clearTimeout(rt);rt=setTimeout(function(){instances.forEach(function(i){i.resize();});if(reduce)drawStatic();},150);});
  document.addEventListener('visibilitychange',function(){if(document.hidden)stop();else if(!reduce)start();});
  if(reduce)drawStatic();else start();
})();
</script>
</body>
