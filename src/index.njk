// === Hero: fade the headline as you leave it ===
(function(){
  var heroContent=document.querySelector('.hero-content');
  var heroStats=document.querySelector('.hero-stats');
  var heroBg=document.querySelector('.hero-bg');
  if(!heroContent) return;

  var reduce=window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  var canHover=window.matchMedia('(hover:hover)').matches;

  function paint(p){
    p=Math.max(0,Math.min(1,p));
    heroContent.style.opacity=1-p;
    if(heroStats) heroStats.style.opacity=1-p;
  }

  // --- Touch: never swallow the gesture. One ordinary swipe scrolls the page
  //     and fades the hero at the same time. ---
  if(!canHover){
    if(reduce) return;
    var ticking=false;
    function onScroll(){
      if(ticking) return;
      ticking=true;
      requestAnimationFrame(function(){
        paint(window.scrollY/(window.innerHeight*0.45));
        ticking=false;
      });
    }
    window.addEventListener('scroll',onScroll,{passive:true});
    onScroll();
    return;
  }

  // --- Pointer devices: hold the first scroll to fade the headline, then release ---
  var progress=0;
  var done=false;
  var SPEED=0.28;

  function render(){ paint(progress); }

  window.addEventListener('wheel',function(e){
    if(window.scrollY<=0 && !done && e.deltaY>0){
      e.preventDefault();
      progress+=SPEED;
      render();
      if(progress>=1){done=true;}
    }
    if(window.scrollY<=0 && done && e.deltaY<0){
      e.preventDefault();
      done=false;
      heroBg.style.position='fixed';
      heroBg.style.height='';
      progress-=SPEED;
      render();
    }
    if(window.scrollY<=0 && !done && progress>0 && e.deltaY<0){
      e.preventDefault();
      progress-=SPEED;
      render();
    }
  },{passive:false});
})();


