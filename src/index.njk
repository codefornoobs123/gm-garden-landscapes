function validateStep1(){
  const name=$('#qName').value.trim();
  const address=$('#qAddress').value.trim();
  const postcode=$('#qPostcode').value.trim();
  const phone=$('#qPhone').value.trim();
  const MSG={qName:'Please enter your name.',qAddress:'Please enter your address.',
             qPostcode:'Please enter your postcode.',qPhone:'Please enter a phone number we can reach you on.'};
  const errors=[];
  if(!name)errors.push('qName');
  if(!address)errors.push('qAddress');
  if(!postcode)errors.push('qPostcode');
  if(!phone||phone.length<7)errors.push('qPhone');
  $$('#quoteForm .qfield-err').forEach(e=>e.remove());
  $$('#quoteForm input,#quoteForm textarea').forEach(f=>{
    f.style.borderColor=''; f.removeAttribute('aria-invalid'); f.removeAttribute('aria-describedby');});
  if(errors.length){
    errors.forEach(id=>{
      const fl=document.getElementById(id); if(!fl) return;
      fl.style.borderColor='var(--err)';
      fl.setAttribute('aria-invalid','true');
      const p=document.createElement('p');
      p.className='qfield-err'; p.id=id+'-err'; p.textContent=MSG[id]||'This field is required.';
      fl.setAttribute('aria-describedby',p.id);
      fl.parentElement.appendChild(p);
    });
    $('#'+errors[0]).focus();
    return false;
  }
  return true;
}
$('#qNext').onclick=()=>{
  if(step===1&&!validateStep1())return;
  if(step<maxStep){step++;showStep();}
};
$('#qBack').onclick=()=>{if(step>1){step--;showStep();}};
$('#quoteForm').addEventListener('submit',async e=>{
  e.preventDefault();
