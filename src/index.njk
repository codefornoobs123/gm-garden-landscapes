permalink: /index.html
---
<!DOCTYPE html>
<html lang="en-GB" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ gm.advanced.seo.title | h }}</title>
<meta name="description" content="{{ gm.advanced.seo.description | h }}">
<meta name="theme-color" content="#23241F">

<meta property="og:type" content="website">
<meta property="og:title" content="{{ gm.advanced.seo.shareTitle | h }}">
<meta property="og:description" content="{{ gm.advanced.seo.shareDescription | h }}">
<meta property="og:locale" content="en_GB">
<meta property="og:site_name" content="{{ gm.advanced.company.name | h }}">
<meta property="og:url" content="https://gmgardenlandscapes.netlify.app/">
<meta property="og:image" content="{{ site.url }}{{ gm.advanced.seo.shareImage | h }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ gm.advanced.seo.shareTitle | h }}">
<meta name="twitter:description" content="{{ gm.advanced.seo.shareDescription | h }}">
<meta name="twitter:image" content="{{ site.url }}{{ gm.advanced.seo.shareImage | h }}">
<link rel="canonical" href="https://gmgardenlandscapes.netlify.app/">

<link rel="icon" href="favicon.ico" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png">
<link rel="icon" type="image/png" sizes="192x192" href="/assets/img/favicon-192.png">
<link rel="apple-touch-icon" sizes="180x180" href="/assets/img/apple-touch-icon.png">

<link rel="preload" as="image" href="{{ gm.pageText.hero.image | h }}" fetchpriority="high">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600&family=Space+Mono&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.44.0/tabler-icons.min.css">

{{ gm | homeSchema | safe }}


<style>{% include "site.css" %}</style>
{% include "head-extra.njk" %}
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body>
{% set navPrefix = "" %}{% include "header.njk" %}

<main id="main">

<section class="hero" id="hero">
  <div class="hero-bg" aria-hidden="true">
    <img src="{{ gm.pageText.hero.image | h }}" fetchpriority="high" alt="{{ gm.pageText.hero.imageAlt | h }}" loading="eager" width="1920" height="1080">
    <div class="hero-overlay"></div>
  </div>
  <div class="wrap hero-in">
    <div class="hero-content">
      <h1><span class="hero-kicker">{{ gm.pageText.hero.kicker | h }}</span> {{ gm.pageText.hero.headlineLine1 | h }}<br>{{ gm.pageText.hero.headlineLine2 | h }}</h1>
      <p class="hero-sub">{{ gm.pageText.hero.subtext | h }}</p>
      <div class="hero-ctas">
        <a href="#quote" class="btn btn-primary btn-lg">{{ gm.pageText.hero.primaryButton | h }} <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 18l6-6"/><path d="M13 6l6 6"/></svg></a>
        <a href="#work" class="btn btn-ghost btn-lg hero-ghost">{{ gm.pageText.hero.secondaryButton | h }}</a>
      </div>
      <div class="hero-trust">
        <div class="ht-badges">
          <span><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2l4-4"/><path d="M12 3a12 12 0 008.5 3A12 12 0 0112 21 12 12 0 013.5 6 12 12 0 0112 3"/></svg> {{ gm.pageText.hero.badge1 | h }}</span>
          <span><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="6"/><path d="M12 15l3.4 5.89 1.6-3.23h3L17 14"/><path d="M6.8 12l-3 .01L5.2 15.23 8.6 20.89 12 15"/></svg> {{ gm.pageText.hero.badge2 | h }}</span>
        </div>
      </div>
    </div>
  </div>
  <div class="hero-stats wrap">
{% for s in gm.pageText.stats %}    <div class="hs"><span class="hs-num" data-count="{{ s.number }}">{{ s.number | num }}</span><span class="hs-suf">{{ s.suffix | h }}</span><span class="hs-lab">{{ s.label | h }}</span></div>
{% endfor %}  </div>
</section>


<section class="section sec-alt" id="work">
  <img class="ivy-drape" src="/assets/img/ivy-drape.png" loading="lazy" decoding="async" alt="" aria-hidden="true" width="1584" height="672">
  <div class="wrap">
{% if gm.pageText.video.show %}
    <div class="video-feature reveal">
      <div class="vf-copy">
        <span class="eyebrow">{{ gm.pageText.video.eyebrow | h }}</span>
        <h2 class="work-sub">{{ gm.pageText.video.heading | h }}</h2>
        <p class="work-note">{{ gm.pageText.video.text | h }}</p>
        <a href="#quote" class="btn btn-primary">Get my free quote <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 18l6-6"/><path d="M13 6l6 6"/></svg></a>
      </div>
      <div class="vf-video">
        <div class="reel">
          <iframe src="https://www.facebook.com/plugins/video.php?height=625&href={{ gm.pageText.video.facebookVideoUrl | urlencode }}&show_text=false&width=350&t=0" width="350" height="625" style="border:none;overflow:hidden" scrolling="no" frameborder="0" allowfullscreen="true" allow="autoplay; clipboard-write; encrypted-media; picture-in-picture" loading="lazy" title="{{ gm.advanced.company.name | h }} &mdash; finished project video"></iframe>
        </div>
      </div>
    </div>
{% endif %}

    <div class="section-head reveal">
      <span class="eyebrow">{{ gm.pageText.work.eyebrow | h }}</span>
      <h2><span class="text-highlight">{{ gm.pageText.work.heading | h }}</span></h2>
    </div>

    <div class="ba-feature reveal">
      <div class="ba-slider">
        <img class="ba-img ba-before" src="{{ gm.beforeAfter.feature.after | h }}" loading="lazy" decoding="async" alt="{{ gm.beforeAfter.feature.afterAlt | h }}">
        <img class="ba-img ba-after" src="{{ gm.beforeAfter.feature.before | h }}" loading="lazy" decoding="async" alt="{{ gm.beforeAfter.feature.beforeAlt | h }}">
        <span class="ba-tag ba-tag-b">Before</span>
        <span class="ba-tag ba-tag-a">After</span>
        <div class="ba-line"></div>
        <div class="ba-handle"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6l-5 6l5 6"/><path d="M16 6l5 6l-5 6"/></svg></div>
      </div>
      <div class="ba-info">
        <h3>{{ gm.beforeAfter.feature.title | h }}</h3>
        <span class="ba-loc"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.5-7-11a7 7 0 0114 0c0 4.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg> {{ gm.beforeAfter.feature.location | h }}</span>
        <ul class="ba-meta">
          <li><span>Project</span><strong>{{ gm.beforeAfter.feature.project | h }}</strong></li>
          <li><span>Materials</span><strong>{{ gm.beforeAfter.feature.materials | h }}</strong></li>
        </ul>
        <a href="#quote" class="btn btn-dark">Get my free quote <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 18l6-6"/><path d="M13 6l6 6"/></svg></a>
      </div>
    </div>

    <div class="work-block reveal">
      <h3 class="work-sub">{{ gm.pageText.work.moreHeading | h }}</h3>
    </div>
    <div class="reveal-grid" id="revealGrid"></div>

    <div class="work-divider reveal"></div>

    <div class="work-block reveal">
      <h3 class="work-sub">{{ gm.pageText.work.finishedHeading | h }}</h3>
      <p class="work-note">{{ gm.pageText.work.finishedNote | h }}</p>
    </div>
    <div class="finished-grid" id="finishedGrid"></div>
  </div>
</section>





<section class="section sec-alt" id="about">
  <div class="wrap about-grid">
    <div class="about-text reveal d1">
      <span class="eyebrow">{{ gm.pageText.about.eyebrow | h }}</span>
      <h2>{{ gm.pageText.about.heading | h }} <span class="text-highlight">{{ gm.pageText.about.headingHighlight | h }}</span></h2>
{% for p in gm.pageText.about.paragraphs | paras %}      <p>{{ p | h }}</p>
{% endfor %}      <div class="about-values">
{% set aboutIcons = ["<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 21h4l13-13a1.5 1.5 0 00-4-4L3 17v4\"/><path d=\"M14.5 5.5l4 4\"/></svg>", "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M8 9h8m-8 4h6\"/><path d=\"M18 4a3 3 0 013 3v8a3 3 0 01-3 3h-5l-5 3v-3H6a3 3 0 01-3-3V7a3 3 0 013-3h12z\"/></svg>", "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 21c.5-4.5 2.5-8 7-10\"/><path d=\"M9 18c6.218 0 10.5-3.288 11-12V4h-4.014c-9 0-11.986 4-12 9 0 1 0 3 2 5h3z\"/></svg>"] %}{% for v in gm.pageText.about.values %}        <div><i>{{ aboutIcons[loop.index0 % 3] }}</i><strong>{{ v.title | h }}</strong><span>{{ v.text | h }}</span></div>
{% endfor %}
      </div>
      <a href="#quote" class="btn btn-primary">{{ gm.pageText.about.button | h }}</a>
    </div>
  </div>
</section>


<section class="section" id="reviews">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">{{ gm.pageText.reviews.eyebrow | h }}</span>
      <h2>{{ gm.pageText.reviews.heading | h }}</h2>
    </div>
    <div class="rev-grid">
{% for r in gm.reviews %}      <figure class="rev-card reveal d{{ loop.index0 % 4 + 1 }}">
        <span class="rev-mark" aria-hidden="true">&ldquo;</span>
        <blockquote>
{% for p in r.text | paras %}          <p>{{ p | h }}</p>
{% endfor %}        </blockquote>
        <figcaption class="rev-by"><strong>{{ r.name | h }}</strong><span>{{ r.location | h }}</span></figcaption>
      </figure>
{% endfor %}    </div>
  </div>
</section>


<section class="section" id="faq">
  <div class="wrap faq-wrap">
    <div class="section-head reveal">
      <span class="eyebrow">{{ gm.pageText.faq.eyebrow | h }}</span>
      <h2>{{ gm.pageText.faq.heading | h }}</h2>
      <p>{{ gm.pageText.faq.intro | withPhone(gm) | h }}</p>
    </div>
    <div class="faq-list reveal" id="faqList"></div>
  </div>
</section>

<section class="section quote-sec" id="quote">
  <div class="wrap quote-grid">
    <div class="quote-intro reveal">
      <span class="eyebrow">{{ gm.pageText.quote.eyebrow | h }}</span>
      <h2>{{ gm.pageText.quote.heading | h }}</h2>
      <p>{{ gm.pageText.quote.intro | h }}</p>
      <ul class="quote-points">
{% for p in gm.pageText.quote.points %}        <li><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg> {{ p | h }}</li>
{% endfor %}      </ul>
      <div class="quote-contact">
        <a href="tel:{{ gm.contact.phoneLink | h }}"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5l-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2"/></svg> {{ gm.contact.phone | h }}</a>
        <a href="mailto:{{ gm.contact.email | h }}"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg> {{ gm.contact.email | h }}</a>
        <span><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg> {{ gm.contact.hoursText | h }}</span>
      </div>
    </div>

    <div class="quote-card reveal d1">
      <div class="qsteps">
        <div class="qstep-bar"><span id="qbar"></span></div>
        <div class="qstep-lab"><span id="qstepnum">Step 1</span> of 3 · <span id="qsteptitle">Your project</span></div>
      </div>

      <form id="quoteForm" name="quote" method="POST" data-netlify="true" netlify-honeypot="bot-field" novalidate>
        <input type="hidden" name="form-name" value="quote">
        <input type="hidden" name="Project types" value="">
        <input type="hidden" name="Photos attached" value="">
        <p style="position:absolute;left:-9999px;" aria-hidden="true"><label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
        <div class="qpanel active" data-step="1">
          <div class="qfield"><label for="qName">Name</label><input type="text" id="qName" name="Name" placeholder="Your full name" autocomplete="name"></div>
          <div class="qfield"><label for="qAddress">Address</label><input type="text" id="qAddress" name="Address" placeholder="House number and street" autocomplete="address-line1"></div>
          <div class="qrow">
            <div class="qfield"><label for="qPostcode">Postcode</label><input type="text" id="qPostcode" name="Postcode" placeholder="e.g. BH1" autocomplete="postal-code"></div>
            <div class="qfield"><label for="qPhone">Phone</label><input type="tel" id="qPhone" name="Phone" placeholder="Mobile number" autocomplete="tel"></div>
          </div>
        </div>

        <div class="qpanel" data-step="2">
          <p class="qlabel" id="qTypesLabel">What do you need? <span>(pick all that apply)</span></p>
          <div class="qchips" id="qProjectTypes" role="group" aria-labelledby="qTypesLabel"></div>
        </div>

        <div class="qpanel" data-step="3">
          <p class="qlabel" id="qStartLabel">When would you like to start?</p>
          <div class="qradios" id="qStart" role="group" aria-labelledby="qStartLabel"></div>
          <div class="qfield" style="margin-top:18px;"><label for="qArea">Approximate area / size</label><input type="text" id="qArea" name="Area" placeholder="e.g. roughly 20m², or 4m x 5m"></div>
          <div class="qfield"><label for="qMaterials">Materials or style preference</label><input type="text" id="qMaterials" name="Materials preference" placeholder="e.g. porcelain paving, resin driveway, or slabs you have in mind"></div>
          <p class="qlabel" style="margin-top:18px;">Add photos <span>(optional, helps us quote accurately)</span></p>
          <label class="qupload"><input type="file" multiple accept="image/*" id="qPhotos"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 8h.01M12.5 21H6a3 3 0 01-3-3V6a3 3 0 013-3h12a3 3 0 013 3v6.5M3 16l5-5c.928-.893 2.072-.893 3 0l3 3M14 14l1-1c.617-.593 1.328-.793 2.009-.598M19 16v6m3-3l-3-3l-3 3"/></svg><span id="qPhotoLabel">Tap to add garden photos</span></label>
          <div class="qfield"><label for="qNotes">Anything else?</label><textarea id="qNotes" name="Notes" placeholder="Tell us a bit about the space, size, ideas..."></textarea></div>
          <p class="qsummary" id="qSummary"></p>
          <p class="qerror" id="qError" style="display:none;color:var(--err);font-size:14px;margin-top:10px;">Something went wrong sending your enquiry — please call us instead, or try again.</p>
        </div>

        <div class="qnav">
          <button type="button" class="btn btn-ghost" id="qBack" style="visibility:hidden;">Back</button>
          <button type="button" class="btn btn-primary" id="qNext">Continue <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 18l6-6"/><path d="M13 6l6 6"/></svg></button>
          <button type="submit" class="btn btn-primary" id="qSubmit" style="display:none;">Send my enquiry <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 14L21 3"/><path d="M21 3l-6.5 18a.55.55 0 01-1 0L10 14l-7-3.5a.55.55 0 010-1L21 3"/></svg></button>
        </div>
      </form>

      <div class="qdone" id="qDone">
        <div class="qdone-ic"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg></div>
        <h3>Thanks — that's with us.</h3>
        <p>We'll be in touch to book your free site visit, and your written quote will follow within a week. For anything urgent, call <a href="tel:{{ gm.contact.phoneLink | h }}">{{ gm.contact.phone | h }}</a>.</p>
      </div>
    </div>
  </div>
</section>

<section class="map-sec">
  <div class="map-grid">
    <div class="map-vis">
      <iframe title="Map of {{ gm.contact.location | h }}"
        src="https://www.google.com/maps?q={{ gm.contact.mapSearch | replace(" ", "+") | h }}&z=12&output=embed"
        width="100%" height="100%" style="border:0;" allowfullscreen=""
        loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>
</section>

</main>

{% include "footer.njk" %}

{% include "after-footer.njk" %}

<script>
const $=(s,c=document)=>c.querySelector(s);
const $$=(s,c=document)=>[...c.querySelectorAll(s)];
// === Before/after reveal cards ===
const revealPairs=[
{% for c in gm.beforeAfter.cards %}  {t:{{ c.title | js }},loc:{{ c.location | js }},b:{{ c.before | js }},a:{{ c.after | js }}}{% if not loop.last %},{% endif %}
{% endfor %}];
const revealGrid=$('#revealGrid');
revealPairs.forEach((p,i)=>{
  const el=document.createElement('div');el.className='ritem';
  el.innerHTML=`
    <div class="rcard" tabindex="0" role="button" aria-label="${p.t} in ${p.loc} — reveal after photo">
      <img class="r-after" loading="lazy" src="${p.a}" alt="After: ${p.t} in ${p.loc}">
      <img class="r-before" loading="lazy" src="${p.b}" alt="Before: ${p.t} in ${p.loc}">
      <span class="r-tag r-tag-after">After</span>
      <span class="r-tag r-tag-before">Before</span>
      <span class="r-hint">hover / tap</span>
    </div>
    <div class="rcard-cap"><strong>${p.t}</strong><span>${p.loc}</span></div>`;
  revealGrid.appendChild(el);
});
$$('.rcard').forEach(c=>{
  c.addEventListener('click',()=>c.classList.toggle('show'));
  c.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();c.classList.toggle('show');}});
});

// === Finished result: one card per project, lightbox cycles through its photos ===
const finished=[
{% for p in gm.photos %}  {t:{{ p.title | js }},{% if p.location %}loc:{{ p.location | js }},{% endif %}cap:{{ p.caption | js }},imgs:{{ p.images | imageList | js }}}{% if not loop.last %},{% endif %}
{% endfor %}];
const finishedGrid=$('#finishedGrid');
finished.forEach((p,i)=>{
  const el=document.createElement('div');el.className='fcard';el.dataset.idx=i;
  el.tabIndex=0; el.setAttribute('role','button');
  el.setAttribute('aria-label',`${p.t}${p.loc?' in '+p.loc:''} \u2014 view ${p.imgs.length} photo${p.imgs.length>1?'s':''}`);
  el.innerHTML=`<img loading="lazy" src="${p.imgs[0]}" alt="${p.t}${p.loc?' in '+p.loc:''}"><span class="fcard-count"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l9 5-9 5-9-5 9-5"/><path d="M3 13l9 5 9-5"/></svg>${p.imgs.length} photos</span><span class="fcard-dots" aria-hidden="true">${p.imgs.map((_,k)=>`<i class="${k===0?'on':''}"></i>`).join('')}</span><div class="fcard-ov">${p.t}${p.loc?' · '+p.loc:''}</div>`;
  finishedGrid.appendChild(el);
});

// Cycle a card's photos while hovering (pointer devices only, and never when motion is reduced)
if(window.matchMedia('(hover:hover)').matches && !window.matchMedia('(prefers-reduced-motion:reduce)').matches){
  $$('.fcard').forEach(card=>{
    const p=finished[+card.dataset.idx]; if(p.imgs.length<2) return;
    const img=card.querySelector('img'), dots=[...card.querySelectorAll('.fcard-dots i')];
    let timer=null, k=0, primed=false;
    const paint=()=>{img.src=p.imgs[k];dots.forEach((d,j)=>d.classList.toggle('on',j===k));};
    card.addEventListener('mouseenter',()=>{
      if(!primed){p.imgs.slice(1).forEach(src=>{const im=new Image();im.src=src;});primed=true;}
      clearInterval(timer);
      timer=setInterval(()=>{k=(k+1)%p.imgs.length;paint();},1100);
    });
    card.addEventListener('mouseleave',()=>{clearInterval(timer);timer=null;k=0;paint();});
  });
}

// === Lightbox (browse each project's photos) ===
const lb=$('#lightbox'),lbCap=$('#lbCap'),lbTrack=$('#lbTrack');
const lbImg=$('#lbImg'),lbPrevImg=$('#lbPrevImg'),lbNextImg=$('#lbNextImg'),lbView=$('.lb-view');
let lbP=0,lbI=0,lbBusy=false,lbQueued=0;
const lbPreloaded=new Set();
function preloadProject(i){
  finished[i].imgs.forEach(src=>{ if(!lbPreloaded.has(src)){ lbPreloaded.add(src); const im=new Image(); im.src=src; } });
}
const lbCount=()=>finished[lbP].imgs.length;
const lbWrap=i=>{const n=lbCount();return (i%n+n)%n;};
function lbStep(){
  const g=parseFloat(getComputedStyle(lbView).getPropertyValue('--lb-gap'))||0;
  return lbView.clientWidth+g;
}
function lbSetTrack(px,animate){
  lbTrack.style.transition = animate ? 'transform .32s cubic-bezier(.22,.61,.36,1)' : 'none';
  lbTrack.style.transform  = 'translateX('+(-lbStep()+px)+'px)';
}
function lbPaint(){
  const p=finished[lbP], n=lbCount();
  lbImg.src=p.imgs[lbI];
  lbImg.alt=`${p.t}${p.loc?' in '+p.loc:''} — photo ${lbI+1}`;
  if(n>1){
    lbPrevImg.src=p.imgs[lbWrap(lbI-1)];
    lbNextImg.src=p.imgs[lbWrap(lbI+1)];
    lbPrevImg.style.visibility=lbNextImg.style.visibility='';
  }else{
    lbPrevImg.removeAttribute('src'); lbNextImg.removeAttribute('src');
    lbPrevImg.style.visibility=lbNextImg.style.visibility='hidden';
  }
  lbCap.innerHTML=`${p.t}${p.loc?' · '+p.loc:''} · ${lbI+1}/${n}<span class="lb-detail"></span>`;
  lbCap.querySelector('.lb-detail').textContent=p.cap||'';
}
// slide the track a whole panel, then silently re-centre on the new photo
function lbGo(dir){
  if(lbCount()<2) return;
  if(lbBusy){ lbQueued=Math.max(-3,Math.min(3,lbQueued+dir)); return; }  // stack fast taps, capped
  lbBusy=true;
  lbSetTrack(-dir*lbStep(),true);
  let settled=false;
  const settle=()=>{
    if(settled) return; settled=true;
    lbTrack.removeEventListener('transitionend',settle);
    lbI=lbWrap(lbI+dir);
    lbPaint();
    lbSetTrack(0,false);
    void lbTrack.offsetWidth;          // flush, so the next move animates
    lbBusy=false;
    if(lbQueued){ const d=lbQueued>0?1:-1; lbQueued-=d; lbGo(d); }
  };
  lbTrack.addEventListener('transitionend',settle);
  setTimeout(settle,420);              // fallback if transitionend never fires
}
let lbOpener=null;
function openLb(i,opener){
  lbOpener = opener || null;
  lbP=i; lbI=0; preloadProject(i);
  lb.classList.add('open'); lb.setAttribute('aria-hidden','false');
  document.body.style.overflow='hidden';
  lbPaint(); lbSetTrack(0,false);
}
finishedGrid.addEventListener('click',e=>{const c=e.target.closest('.fcard');if(c)openLb(+c.dataset.idx,c);});
finishedGrid.addEventListener('keydown',e=>{
  if(e.key!=='Enter'&&e.key!==' '&&e.key!=='Spacebar') return;
  const c=e.target.closest('.fcard'); if(!c) return;
  e.preventDefault(); openLb(+c.dataset.idx,c);
});
$('#lbClose').onclick=()=>{
  lb.classList.remove('open'); lb.setAttribute('aria-hidden','true'); document.body.style.overflow='';
  if(lbOpener){ lbOpener.focus(); lbOpener=null; }
};
$('#lbNext').onclick=()=>lbGo(1);
$('#lbPrev').onclick=()=>lbGo(-1);
lb.addEventListener('click',e=>{if(e.target===lb)$('#lbClose').click();});
window.addEventListener('resize',()=>{if(lb.classList.contains('open')&&!lbBusy)lbSetTrack(0,false);});
document.addEventListener('keydown',e=>{if(!lb.classList.contains('open'))return;if(e.key==='Escape')$('#lbClose').click();if(e.key==='ArrowRight')lbGo(1);if(e.key==='ArrowLeft')lbGo(-1);});

// Drag the track with your finger — the neighbouring photo comes in as you go
(function(){
  const view=lbView; if(!view) return;
  let x0=0,y0=0,dx=0,dragging=false,decided=false,horizontal=false;
  view.addEventListener('touchstart',e=>{
    if(e.touches.length!==1||lbBusy||lbCount()<2) return;
    x0=e.touches[0].clientX; y0=e.touches[0].clientY;
    dx=0; dragging=true; decided=false; horizontal=false;
    lbTrack.style.transition='none';
  },{passive:true});
  view.addEventListener('touchmove',e=>{
    if(!dragging||e.touches.length!==1) return;
    const cx=e.touches[0].clientX, cy=e.touches[0].clientY;
    const ax=Math.abs(cx-x0), ay=Math.abs(cy-y0);
    if(!decided && (ax>8||ay>8)){ decided=true; horizontal=ax>ay; }
    if(!horizontal) return;
    dx=cx-x0;
    if(e.cancelable) e.preventDefault();
    lbSetTrack(dx,false);
  },{passive:false});
  const finish=()=>{
    if(!dragging) return;
    dragging=false;
    const thresh=Math.min(70,lbView.clientWidth*0.18);
    if(horizontal && Math.abs(dx)>thresh) lbGo(dx<0?1:-1);
    else lbSetTrack(0,true);
    dx=0;
  };
  view.addEventListener('touchend',finish,{passive:true});
  view.addEventListener('touchcancel',finish,{passive:true});
})();





